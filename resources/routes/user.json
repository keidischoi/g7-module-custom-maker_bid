{
  "version": "1.0.0",
  "routes": [
    {
      "path": "*/maker-bid",
      "layout": "jobs_list",
      "auth_required": false,
      "meta": { "title": "의뢰목록" }
    },
    {
      "path": "*/maker-bid/new",
      "layout": "jobs_create",
      "auth_required": true,
      "meta": { "title": "의뢰서 작성" }
    },
    {
      "path": "*/maker-bid/bids",
      "layout": "jobs_bids",
      "auth_required": false,
      "meta": { "title": "입찰현황" }
    },
    {
      "path": "*/maker-bid/history",
      "layout": "jobs_history",
      "auth_required": false,
      "meta": { "title": "이력" }
    },
    {
      "path": "*/maker-bid/company",
      "layout": "company_apply",
      "auth_required": true,
      "meta": { "title": "입찰자 등록" }
    },
    {
      "path": "*/maker-bid/:id/edit",
      "layout": "jobs_edit",
      "auth_required": true,
      "meta": { "title": "의뢰서 수정" }
    },
    {
      "path": "*/maker-bid/:id",
      "layout": "jobs_show",
      "auth_required": false,
      "meta": { "title": "의뢰 상세" }
    },
    {
      "path": "*/cmb_maker_nav",
      "layout": "cmb_maker_nav",
      "auth_required": false,
      "meta": { "title": " " }
    }
  ]
}
