{
  "version": "1.0.0",
  "layout_name": "companies_index",
  "extends": "_admin_base",
  "meta": { "title": "회사 목록" },
  "permissions": ["custom-maker_bid.companies.read"],
  "errorHandling": {
    "401": { "handler": "toast", "params": { "type": "warning", "message": "로그인이 필요합니다." } },
    "403": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "422": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "default": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
  },
  "state": {
    "filter": { "status": "" },
    "reject": { "rejected_reason": "" }
  },
  "data_sources": [
    {
      "id": "companies",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/admin/companies",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "refetchOnMount": true,
      "params": {
        "status": "{{_local.filter.status}}"
      },
      "fallback": { "data": [] }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "admin-page-content space-y-6" },
        "children": [
          { "id": "h", "type": "basic", "name": "H1", "props": { "className": "page-title" }, "text": "회사 목록" },
          {
            "id": "nav",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-center gap-3 flex-wrap text-sm" },
            "children": [
              { "id": "n1", "type": "basic", "name": "A", "props": { "href": "/admin/maker-bid" }, "text": "의뢰 목록" },
              { "id": "n2", "type": "basic", "name": "A", "props": { "href": "/admin/maker-bid/bids" }, "text": "입찰 관리" },
              { "id": "n3", "type": "basic", "name": "A", "props": { "href": "/admin/maker-bid/companies" }, "text": "회사 목록" },
              { "id": "n4", "type": "basic", "name": "A", "props": { "href": "/admin/maker-bid/activity" }, "text": "회원 활동" }
            ]
          },
          { "id": "d", "type": "basic", "name": "P", "props": { "className": "text-secondary text-sm" }, "text": "회원 업체 신청을 승인·거절·삭제합니다. 상태 pending / approved / rejected." },
          {
            "id": "filters",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-end gap-2 flex-wrap", "dataKey": "filter", "trackChanges": true },
            "children": [
              { "id": "fstatus", "type": "basic", "name": "Input", "props": { "name": "status", "placeholder": "상태" } },
              {
                "id": "fgo",
                "type": "basic",
                "name": "Button",
                "text": "필터",
                "props": { "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900" },
                "actions": [
                  { "type": "click", "handler": "refetchDataSource", "params": { "dataSourceId": "companies" } }
                ]
              }
            ]
          },
          {
            "id": "reject_box",
            "type": "basic",
            "name": "Div",
            "props": { "className": "max-w-xl space-y-2", "dataKey": "reject", "trackChanges": true },
            "children": [
              { "id": "rl", "type": "basic", "name": "P", "props": { "className": "text-sm text-secondary" }, "text": "거절 사유 (거절 버튼에 함께 전송)" },
              { "id": "rreason", "type": "basic", "name": "Input", "props": { "name": "rejected_reason", "placeholder": "거절 사유" } }
            ]
          },
          {
            "id": "empty",
            "type": "basic",
            "name": "P",
            "if": "{{!(companies.data && companies.data.length)}}",
            "props": { "className": "text-secondary text-sm py-8" },
            "text": "등록된 업체가 없습니다."
          },
          {
            "id": "crow",
            "type": "basic",
            "name": "Div",
            "props": { "className": "py-3 border-b border-gray-200 dark:border-white/10 space-y-2" },
            "iteration": { "source": "{{companies.data}}", "item_var": "$co" },
            "children": [
              { "id": "ctxt", "type": "basic", "name": "P", "text": "#{{$co.id}} {{$co.name}} · 회원 {{$co.user_id}} · {{$co.status}} · {{$co.type ?? ''}} · {{$co.rejected_reason ?? ''}}" },
              {
                "id": "cacts",
                "type": "basic",
                "name": "Div",
                "props": { "className": "flex items-center gap-2 flex-wrap" },
                "children": [
                  {
                    "id": "approve",
                    "type": "basic",
                    "name": "Button",
                    "text": "승인",
                    "props": { "className": "px-3 py-1 text-sm rounded-lg border border-gray-300 dark:border-gray-600" },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bid/admin/companies/{{$co.id}}/approve",
                        "params": { "method": "POST" },
                        "confirm": "이 업체를 승인할까요?",
                        "onSuccess": [
                          { "handler": "toast", "params": { "type": "success", "message": "승인했습니다." } },
                          { "handler": "refetchDataSource", "params": { "dataSourceId": "companies" } }
                        ],
                        "onError": [
                          { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "reject",
                    "type": "basic",
                    "name": "Button",
                    "text": "거절",
                    "props": { "className": "px-3 py-1 text-sm rounded-lg border border-gray-300 dark:border-gray-600" },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bid/admin/companies/{{$co.id}}/reject",
                        "params": { "method": "POST", "body": "{{_local.reject}}" },
                        "confirm": "이 업체를 거절할까요?",
                        "onSuccess": [
                          { "handler": "toast", "params": { "type": "success", "message": "거절했습니다." } },
                          { "handler": "refetchDataSource", "params": { "dataSourceId": "companies" } }
                        ],
                        "onError": [
                          { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "del",
                    "type": "basic",
                    "name": "Button",
                    "text": "삭제",
                    "props": { "className": "px-3 py-1 text-sm rounded-lg text-red-600" },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bid/admin/companies/{{$co.id}}",
                        "params": { "method": "DELETE" },
                        "confirm": "이 업체를 삭제할까요?",
                        "onSuccess": [
                          { "handler": "toast", "params": { "type": "success", "message": "삭제했습니다." } },
                          { "handler": "refetchDataSource", "params": { "dataSourceId": "companies" } }
                        ],
                        "onError": [
                          { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
