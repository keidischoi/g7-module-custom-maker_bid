{
  "version": "1.0.0",
  "layout_name": "companies_index",
  "extends": "_admin_base",
  "meta": { "title": "회사 목록" },
  "permissions": ["custom-maker_bid.companies.read"],
  "errorHandling": {
    "401": { "handler": "toast", "params": { "type": "warning", "message": "로그인이 필요합니다." } },
    "403": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "422": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "default": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
  },
  "state": {
    "filter": { "status": "" },
    "reject": { "rejected_reason": "" },
    "hold": { "hold_reason": "" },
    "edit": {
      "id": "",
      "status": "pending",
      "admin_memo": "",
      "hold_reason": "",
      "rating_score": "0",
      "rating_count": "0",
      "claim_count": "0",
      "claim_history": "",
      "report_count": "0",
      "is_recommended": false,
      "priority": "0"
    }
  },
  "data_sources": [
    {
      "id": "companies",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/admin/companies",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "refetchOnMount": true,
      "params": {
        "status": "{{_local.filter.status}}"
      },
      "fallback": { "data": [] }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "admin-page-content space-y-6" },
        "children": [
          { "id": "h", "type": "basic", "name": "H1", "props": { "className": "page-title" }, "text": "회사 목록" },
          {
            "id": "nav",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-center gap-3 flex-wrap text-sm" },
            "children": [
              { "id": "n1", "type": "basic", "name": "A", "props": { "href": "/admin/maker-bid" }, "text": "의뢰 목록" },
              { "id": "ntypes", "type": "basic", "name": "A", "props": { "href": "/admin/maker-bid/types" }, "text": "유형 관리" },
              { "id": "n2", "type": "basic", "name": "A", "props": { "href": "/admin/maker-bid/bids" }, "text": "입찰 관리" },
              { "id": "n3", "type": "basic", "name": "A", "props": { "href": "/admin/maker-bid/companies" }, "text": "회사 목록" },
              { "id": "n4", "type": "basic", "name": "A", "props": { "href": "/admin/maker-bid/activity" }, "text": "회원 활동" }
            ]
          },
          { "id": "d", "type": "basic", "name": "P", "props": { "className": "text-secondary text-sm" }, "text": "입찰자 신청을 보류·승인·거절하고, 추천/우선 노출·평점·크레임·신고를 관리합니다. 목록은 추천·우선 노출 순입니다." },
          {
            "id": "filters",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-end gap-2 flex-wrap", "dataKey": "filter", "trackChanges": true },
            "children": [
              { "id": "fstatus", "type": "basic", "name": "Input", "props": { "name": "status", "placeholder": "상태 pending/approved/rejected" } },
              {
                "id": "fgo",
                "type": "basic",
                "name": "Button",
                "text": "필터",
                "props": { "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900" },
                "actions": [
                  { "type": "click", "handler": "refetchDataSource", "params": { "dataSourceId": "companies" } }
                ]
              }
            ]
          },
          {
            "id": "edit_box",
            "type": "basic",
            "name": "Div",
            "props": { "className": "max-w-2xl space-y-2 p-4 rounded-xl border border-gray-200 dark:border-white/10", "dataKey": "edit", "trackChanges": true },
            "children": [
              { "id": "eh", "type": "basic", "name": "P", "props": { "className": "font-medium" }, "text": "선택 업체 관리 (#{{_local.edit.id || '-'}})" },
              { "id": "estatus_l", "type": "basic", "name": "P", "props": { "className": "text-sm text-secondary" }, "text": "승인 여부 (pending 보류 / approved 승인 / rejected 거절)" },
              { "id": "estatus", "type": "basic", "name": "Input", "props": { "name": "status", "placeholder": "pending" } },
              { "id": "ememo_l", "type": "basic", "name": "P", "props": { "className": "text-sm text-secondary" }, "text": "관리자 메모" },
              { "id": "ememo", "type": "basic", "name": "Textarea", "props": { "name": "admin_memo", "placeholder": "관리자 메모" } },
              { "id": "ehold_l", "type": "basic", "name": "P", "props": { "className": "text-sm text-secondary" }, "text": "보류 이유" },
              { "id": "ehold", "type": "basic", "name": "Input", "props": { "name": "hold_reason", "placeholder": "보류 이유" } },
              { "id": "erate_l", "type": "basic", "name": "P", "props": { "className": "text-sm text-secondary" }, "text": "평점 (0–5) / 평점 수" },
              {
                "id": "erate_row",
                "type": "basic",
                "name": "Div",
                "props": { "className": "flex items-center gap-2" },
                "children": [
                  { "id": "escore", "type": "basic", "name": "Input", "props": { "name": "rating_score", "type": "number", "min": "0", "max": "5", "step": "0.1", "placeholder": "4.5" } },
                  { "id": "ecount", "type": "basic", "name": "Input", "props": { "name": "rating_count", "type": "number", "min": "0", "placeholder": "12" } }
                ]
              },
              { "id": "eclaim_l", "type": "basic", "name": "P", "props": { "className": "text-sm text-secondary" }, "text": "크레임 건수 / 크레임 이력" },
              { "id": "eclaimc", "type": "basic", "name": "Input", "props": { "name": "claim_count", "type": "number", "min": "0", "placeholder": "0" } },
              { "id": "eclaimh", "type": "basic", "name": "Textarea", "props": { "name": "claim_history", "placeholder": "한 줄에 하나씩, 또는 JSON" } },
              { "id": "erep_l", "type": "basic", "name": "P", "props": { "className": "text-sm text-secondary" }, "text": "신고 건수" },
              { "id": "erep", "type": "basic", "name": "Input", "props": { "name": "report_count", "type": "number", "min": "0", "placeholder": "0" } },
              {
                "id": "erec_wrap",
                "type": "basic",
                "name": "Label",
                "props": { "className": "inline-flex items-center gap-2 text-sm cursor-pointer" },
                "children": [
                  { "id": "erec", "type": "basic", "name": "Checkbox", "props": { "name": "is_recommended" } },
                  { "id": "erec_txt", "type": "basic", "name": "Span", "text": "추천업체 또는 추천 입찰자" }
                ]
              },
              { "id": "epri_l", "type": "basic", "name": "P", "props": { "className": "text-sm text-secondary" }, "text": "업체 우선 노출 (숫자 클수록 앞)" },
              { "id": "epri", "type": "basic", "name": "Input", "props": { "name": "priority", "type": "number", "min": "0", "placeholder": "0" } },
              {
                "id": "esave",
                "type": "basic",
                "name": "Button",
                "text": "선택 업체 저장",
                "props": { "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900" },
                "actions": [
                  {
                    "type": "click",
                    "handler": "apiCall",
                    "auth_required": true,
                    "target": "/api/modules/custom-maker_bid/admin/companies/{{_local.edit.id}}",
                    "params": { "method": "PATCH", "body": "{{_local.edit}}" },
                    "onSuccess": [
                      { "handler": "toast", "params": { "type": "success", "message": "저장했습니다." } },
                      { "handler": "refetchDataSource", "params": { "dataSourceId": "companies" } }
                    ],
                    "onError": [
                      { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "reject_box",
            "type": "basic",
            "name": "Div",
            "props": { "className": "max-w-xl space-y-2", "dataKey": "reject", "trackChanges": true },
            "children": [
              { "id": "rl", "type": "basic", "name": "P", "props": { "className": "text-sm text-secondary" }, "text": "거절 사유 (거절 버튼에 함께 전송)" },
              { "id": "rreason", "type": "basic", "name": "Input", "props": { "name": "rejected_reason", "placeholder": "거절 사유" } }
            ]
          },
          {
            "id": "hold_box",
            "type": "basic",
            "name": "Div",
            "props": { "className": "max-w-xl space-y-2", "dataKey": "hold", "trackChanges": true },
            "children": [
              { "id": "hl", "type": "basic", "name": "P", "props": { "className": "text-sm text-secondary" }, "text": "보류 이유 (보류 버튼에 함께 전송)" },
              { "id": "hreason", "type": "basic", "name": "Input", "props": { "name": "hold_reason", "placeholder": "보류 이유" } }
            ]
          },
          {
            "id": "empty",
            "type": "basic",
            "name": "P",
            "if": "{{!(companies.data && companies.data.length)}}",
            "props": { "className": "text-secondary text-sm py-8" },
            "text": "등록된 업체가 없습니다."
          },
          {
            "id": "crow",
            "type": "basic",
            "name": "Div",
            "props": { "className": "py-3 border-b border-gray-200 dark:border-white/10 space-y-2" },
            "iteration": { "source": "{{companies.data}}", "item_var": "$co" },
            "children": [
              { "id": "ctxt", "type": "basic", "name": "P", "text": "#{{$co.id}} {{$co.name}} · {{$co.kind_label || $co.kind}} · 회원 {{$co.user_id}} · {{$co.status_label || $co.status}}{{$co.is_recommended ? ' · 추천' : ''}} · 우선 {{$co.priority ?? 0}} · 평점 {{$co.rating_score ?? 0}}/{{$co.rating_count ?? 0}} · 크레임 {{$co.claim_count ?? 0}} · 신고 {{$co.report_count ?? 0}}" },
              { "id": "cmemo", "type": "basic", "name": "P", "props": { "className": "text-sm text-secondary" }, "text": "{{$co.admin_memo || $co.hold_reason || $co.rejected_reason || ''}}" },
              {
                "id": "cacts",
                "type": "basic",
                "name": "Div",
                "props": { "className": "flex items-center gap-2 flex-wrap" },
                "children": [
                  {
                    "id": "load",
                    "type": "basic",
                    "name": "Button",
                    "text": "불러오기",
                    "props": { "className": "px-3 py-1 text-sm rounded-lg border border-gray-300 dark:border-gray-600" },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "edit.id": "{{$co.id}}",
                          "edit.status": "{{$co.status}}",
                          "edit.admin_memo": "{{$co.admin_memo || ''}}",
                          "edit.hold_reason": "{{$co.hold_reason || ''}}",
                          "edit.rating_score": "{{$co.rating_score}}",
                          "edit.rating_count": "{{$co.rating_count}}",
                          "edit.claim_count": "{{$co.claim_count}}",
                          "edit.claim_history": "{{$co.claim_history}}",
                          "edit.report_count": "{{$co.report_count}}",
                          "edit.is_recommended": "{{$co.is_recommended}}",
                          "edit.priority": "{{$co.priority}}"
                        }
                      }
                    ]
                  },
                  {
                    "id": "approve",
                    "type": "basic",
                    "name": "Button",
                    "text": "승인",
                    "props": { "className": "px-3 py-1 text-sm rounded-lg border border-gray-300 dark:border-gray-600" },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bid/admin/companies/{{$co.id}}/approve",
                        "params": { "method": "POST" },
                        "confirm": "이 업체를 승인할까요?",
                        "onSuccess": [
                          { "handler": "toast", "params": { "type": "success", "message": "승인했습니다." } },
                          { "handler": "refetchDataSource", "params": { "dataSourceId": "companies" } }
                        ],
                        "onError": [
                          { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "hold",
                    "type": "basic",
                    "name": "Button",
                    "text": "보류",
                    "props": { "className": "px-3 py-1 text-sm rounded-lg border border-gray-300 dark:border-gray-600" },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bid/admin/companies/{{$co.id}}/hold",
                        "params": { "method": "POST", "body": "{{_local.hold}}" },
                        "confirm": "이 업체를 보류할까요?",
                        "onSuccess": [
                          { "handler": "toast", "params": { "type": "success", "message": "보류했습니다." } },
                          { "handler": "refetchDataSource", "params": { "dataSourceId": "companies" } }
                        ],
                        "onError": [
                          { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "reject",
                    "type": "basic",
                    "name": "Button",
                    "text": "거절",
                    "props": { "className": "px-3 py-1 text-sm rounded-lg border border-gray-300 dark:border-gray-600" },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bid/admin/companies/{{$co.id}}/reject",
                        "params": { "method": "POST", "body": "{{_local.reject}}" },
                        "confirm": "이 업체를 거절할까요?",
                        "onSuccess": [
                          { "handler": "toast", "params": { "type": "success", "message": "거절했습니다." } },
                          { "handler": "refetchDataSource", "params": { "dataSourceId": "companies" } }
                        ],
                        "onError": [
                          { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "del",
                    "type": "basic",
                    "name": "Button",
                    "text": "삭제",
                    "props": { "className": "px-3 py-1 text-sm rounded-lg text-red-600" },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bid/admin/companies/{{$co.id}}",
                        "params": { "method": "DELETE" },
                        "confirm": "이 업체를 삭제할까요?",
                        "onSuccess": [
                          { "handler": "toast", "params": { "type": "success", "message": "삭제했습니다." } },
                          { "handler": "refetchDataSource", "params": { "dataSourceId": "companies" } }
                        ],
                        "onError": [
                          { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
