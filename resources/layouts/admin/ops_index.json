{
  "version": "1.0.0",
  "layout_name": "ops_index",
  "extends": "_admin_base",
  "meta": {
    "title": "운영(클레임/신고/로그)"
  },
  "permissions": [
    "custom-maker_bids.jobs.read"
  ],
  "errorHandling": {
    "401": {
      "handler": "toast",
      "params": {
        "type": "warning",
        "message": "로그인이 필요합니다."
      }
    },
    "403": {
      "handler": "toast",
      "params": {
        "type": "error",
        "message": "{{error.message}}"
      }
    },
    "422": {
      "handler": "toast",
      "params": {
        "type": "error",
        "message": "{{error.message}}"
      }
    },
    "default": {
      "handler": "toast",
      "params": {
        "type": "error",
        "message": "{{error.message}}"
      }
    }
  },
  "data_sources": [
    {
      "id": "ops",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bids/admin/ops",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "refetchOnMount": true,
      "fallback": {
        "data": {
          "claims": [],
          "reports": [],
          "audits": [],
          "file_logs": [],
          "closed": 0
        }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "admin-page-content cmb-admin space-y-5 w-full"
        },
        "children": [
          {
            "id": "h",
            "type": "basic",
            "name": "H1",
            "props": {
              "className": "page-title"
            },
            "text": "운영"
          },
          {
            "id": "cmb_admin_nav",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-admin-nav text-sm",
              "data-cmb-admin-nav": "1"
            },
            "children": []
          },
          {
            "id": "d",
            "type": "basic",
            "name": "P",
            "props": {
              "className": "cmb-admin-lead"
            },
            "text": "클레임·신고·감사 로그를 확인합니다. 마감 자동종료 {{ops.data.closed ?? 0}}건 (조회 시 반영)."
          },
          {
            "id": "claims_card",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-admin-card space-y-3 w-full"
            },
            "children": [
              {
                "id": "ch",
                "type": "basic",
                "name": "P",
                "props": {
                  "className": "cmb-admin-card-title"
                },
                "text": "클레임"
              },
              {
                "id": "cempty",
                "type": "basic",
                "name": "P",
                "if": "{{!(ops.data.claims && ops.data.claims.length)}}",
                "props": {
                  "className": "cmb-admin-empty"
                },
                "text": "클레임이 없습니다."
              },
              {
                "id": "clist",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-admin-list w-full"
                },
                "children": [
                  {
                    "id": "crow",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "cmb-admin-row w-full flex flex-row flex-nowrap items-center justify-between"
                    },
                    "iteration": {
                      "source": "{{ops.data.claims}}",
                      "item_var": "$item"
                    },
                    "children": [
                      {
                        "id": "cmain",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "cmb-admin-row-main min-w-0 flex-1 flex flex-row flex-nowrap items-center"
                        },
                        "children": [
                          {
                            "id": "ctitle",
                            "type": "basic",
                            "name": "A",
                            "props": {
                              "href": "/admin/maker-bids/jobs/{{$item.job_id}}",
                              "className": "cmb-admin-row-title"
                            },
                            "text": "클레임 #{{$item.id}} · 의뢰 #{{$item.job_id}}"
                          },
                          {
                            "id": "cmeta",
                            "type": "basic",
                            "name": "P",
                            "props": {
                              "className": "cmb-admin-muted"
                            },
                            "text": "{{$item.factor_label || $item.status}} · {{$item.status_label || $item.status}} · {{$item.reason}}"
                          }
                        ]
                      },
                      {
                        "id": "cacts",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "cmb-admin-row-actions shrink-0 ml-auto flex flex-row items-center"
                        },
                        "children": [
                          {
                            "id": "cclose",
                            "type": "basic",
                            "name": "Button",
                            "text": "종결",
                            "if": "{{$item.status !== 'closed'}}",
                            "props": {
                              "className": "px-3 py-1 text-sm rounded-lg border"
                            },
                            "actions": [
                              {
                                "type": "click",
                                "handler": "apiCall",
                                "auth_required": true,
                                "target": "/api/modules/custom-maker_bids/admin/claims/{{$item.id}}",
                                "params": {
                                  "method": "POST",
                                  "body": {
                                    "status": "closed",
                                    "admin_note": "관리자 종결"
                                  }
                                },
                                "confirm": "이 클레임을 종결할까요?",
                                "onSuccess": [
                                  {
                                    "handler": "toast",
                                    "params": {
                                      "type": "success",
                                      "message": "클레임을 종결했습니다."
                                    }
                                  },
                                  {
                                    "handler": "refetchDataSource",
                                    "params": {
                                      "dataSourceId": "ops"
                                    }
                                  }
                                ],
                                "onError": [
                                  {
                                    "handler": "toast",
                                    "params": {
                                      "type": "error",
                                      "message": "{{error.message}}"
                                    }
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "id": "creopen",
                            "type": "basic",
                            "name": "Button",
                            "text": "재오픈",
                            "if": "{{$item.status === 'closed'}}",
                            "props": {
                              "className": "px-3 py-1 text-sm rounded-lg border"
                            },
                            "actions": [
                              {
                                "type": "click",
                                "handler": "apiCall",
                                "auth_required": true,
                                "target": "/api/modules/custom-maker_bids/admin/claims/{{$item.id}}",
                                "params": {
                                  "method": "POST",
                                  "body": {
                                    "status": "open",
                                    "admin_note": "관리자 재오픈"
                                  }
                                },
                                "confirm": "이 클레임을 다시 열까요?",
                                "onSuccess": [
                                  {
                                    "handler": "toast",
                                    "params": {
                                      "type": "success",
                                      "message": "클레임을 재오픈했습니다."
                                    }
                                  },
                                  {
                                    "handler": "refetchDataSource",
                                    "params": {
                                      "dataSourceId": "ops"
                                    }
                                  }
                                ],
                                "onError": [
                                  {
                                    "handler": "toast",
                                    "params": {
                                      "type": "error",
                                      "message": "{{error.message}}"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "reports_card",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-admin-card space-y-3 w-full"
            },
            "children": [
              {
                "id": "rh",
                "type": "basic",
                "name": "P",
                "props": {
                  "className": "cmb-admin-card-title"
                },
                "text": "신고"
              },
              {
                "id": "rempty",
                "type": "basic",
                "name": "P",
                "if": "{{!(ops.data.reports && ops.data.reports.length)}}",
                "props": {
                  "className": "cmb-admin-empty"
                },
                "text": "신고가 없습니다."
              },
              {
                "id": "rlist",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-admin-list w-full"
                },
                "children": [
                  {
                    "id": "rrow",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "cmb-admin-row w-full flex flex-row flex-nowrap items-center justify-between"
                    },
                    "iteration": {
                      "source": "{{ops.data.reports}}",
                      "item_var": "$item"
                    },
                    "children": [
                      {
                        "id": "rmain",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "cmb-admin-row-main min-w-0 flex-1 flex flex-row flex-nowrap items-center"
                        },
                        "children": [
                          {
                            "id": "rtitle",
                            "type": "basic",
                            "name": "A",
                            "props": {
                              "href": "/admin/maker-bids/jobs/{{$item.job_id}}",
                              "className": "cmb-admin-row-title"
                            },
                            "text": "신고 #{{$item.id}} · 의뢰 #{{$item.job_id}}"
                          },
                          {
                            "id": "rmeta",
                            "type": "basic",
                            "name": "P",
                            "props": {
                              "className": "cmb-admin-muted"
                            },
                            "text": "{{$item.factor_label || $item.status}} · {{$item.status_label || $item.status}} · {{$item.reason}}"
                          }
                        ]
                      },
                      {
                        "id": "racts",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "cmb-admin-row-actions shrink-0 ml-auto flex flex-row items-center"
                        },
                        "children": [
                          {
                            "id": "rjob",
                            "type": "basic",
                            "name": "A",
                            "props": {
                              "href": "/admin/maker-bids/jobs/{{$item.job_id}}",
                              "className": "px-3 py-1 text-sm rounded-lg border"
                            },
                            "text": "의뢰 보기"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "audits_card",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-admin-card space-y-3 w-full"
            },
            "children": [
              {
                "id": "ah",
                "type": "basic",
                "name": "P",
                "props": {
                  "className": "cmb-admin-card-title"
                },
                "text": "감사 로그"
              },
              {
                "id": "aempty",
                "type": "basic",
                "name": "P",
                "if": "{{!(ops.data.audits && ops.data.audits.length)}}",
                "props": {
                  "className": "cmb-admin-empty"
                },
                "text": "감사 로그가 없습니다."
              },
              {
                "id": "alist",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-admin-list w-full"
                },
                "children": [
                  {
                    "id": "arow",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "cmb-admin-row w-full flex flex-row flex-nowrap items-center justify-between"
                    },
                    "iteration": {
                      "source": "{{ops.data.audits}}",
                      "item_var": "$item"
                    },
                    "children": [
                      {
                        "id": "amain",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "cmb-admin-row-main min-w-0 flex-1 flex flex-row flex-nowrap items-center"
                        },
                        "children": [
                          {
                            "id": "atitle",
                            "type": "basic",
                            "name": "P",
                            "props": {
                              "className": "cmb-admin-row-title"
                            },
                            "text": "{{$item.action}} · {{$item.subject_type}}#{{$item.subject_id}}"
                          },
                          {
                            "id": "ameta",
                            "type": "basic",
                            "name": "P",
                            "props": {
                              "className": "cmb-admin-muted"
                            },
                            "text": "{{$item.created_at}} · 회원 {{$item.user_id ?? '-'}}"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "reports_resolve_help",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-admin-card mt-4 space-y-2"
            },
            "children": [
              {
                "id": "rrh",
                "type": "basic",
                "name": "H2",
                "props": {
                  "className": "cmb-section-title"
                },
                "text": "신고 종결"
              },
              {
                "id": "rrg",
                "type": "basic",
                "name": "P",
                "props": {
                  "className": "cmb-page-guide"
                },
                "text": "신고 ID를 입력하고 종결합니다. API: POST admin/reports/{id}"
              },
              {
                "id": "rr_box",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "flex gap-2 mt-2",
                  "dataKey": "report_resolve",
                  "trackChanges": true
                },
                "children": [
                  {
                    "id": "rr_id",
                    "type": "basic",
                    "name": "Input",
                    "props": {
                      "name": "id",
                      "placeholder": "신고 ID",
                      "className": "cmb-order-field"
                    }
                  },
                  {
                    "id": "rr_btn",
                    "type": "basic",
                    "name": "Button",
                    "text": "신고 종결",
                    "props": {
                      "className": "cmb-btn cmb-btn-primary"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bids/admin/reports/{{_local.report_resolve.id}}",
                        "params": {
                          "method": "POST",
                          "body": {
                            "status": "closed"
                          }
                        },
                        "onSuccess": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "success",
                              "message": "신고를 종결했습니다."
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "error",
                              "message": "{{error.message}}"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
