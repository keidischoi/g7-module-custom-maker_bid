{
  "version": "1.0.0",
  "layout_name": "ops_index",
  "extends": "_admin_base",
  "meta": { "title": "운영(클레임/신고/로그)" },
  "permissions": ["custom-maker_bids.jobs.read"],
  "data_sources": [
    {
      "id": "ops",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bids/admin/ops",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "admin-page-content cmb-admin space-y-4" },
        "children": [
          { "id": "h", "type": "basic", "name": "H1", "text": "운영" },
          { "id": "d", "type": "basic", "name": "P", "text": "마감 자동종료 {{ops.data.closed}}건. 클레임/신고/감사로그." },
          { "id": "c", "type": "basic", "name": "P", "text": "클레임 #{{$item.id}} job {{$item.job_id}} {{$item.status}} {{$item.reason}}", "iteration": { "source": "{{ops.data.claims}}", "item_var": "$item" } },
          { "id": "r", "type": "basic", "name": "P", "text": "신고 #{{$item.id}} job {{$item.job_id}} {{$item.reason}}", "iteration": { "source": "{{ops.data.reports}}", "item_var": "$item" } },
          { "id": "a", "type": "basic", "name": "P", "text": "{{$item.created_at}} {{$item.action}} {{$item.subject_type}}#{{$item.subject_id}}", "iteration": { "source": "{{ops.data.audits}}", "item_var": "$item" } }
        ]
      }
    ]
  }
}
