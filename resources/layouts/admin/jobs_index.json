{
  "version": "1.0.0",
  "layout_name": "jobs_index",
  "extends": "_admin_base",
  "meta": { "title": "의뢰/입찰 관리" },
  "data_sources": [
    {
      "id": "jobs",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/admin/jobs",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "refetchOnMount": true
    },
    {
      "id": "companies",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/admin/companies",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "refetchOnMount": true
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "admin-page-content space-y-8" },
        "children": [
          { "id": "h", "type": "basic", "name": "H1", "props": { "className": "page-title" }, "text": "의뢰/입찰 관리" },
          { "id": "d", "type": "basic", "name": "P", "props": { "className": "text-secondary text-sm" }, "text": "회원 의뢰서 삭제·보류·수정, 입찰 업체 승인" },
          { "id": "jh", "type": "basic", "name": "H2", "text": "의뢰 목록" },
          {
            "id": "jrow",
            "type": "basic",
            "name": "P",
            "props": { "className": "py-2 border-b border-gray-200 dark:border-white/10" },
            "iteration": { "source": "{{jobs.data}}", "item_var": "$item" },
            "text": "#{{$item.id}} {{$item.title}} [{{$item.type}}] {{$item.status}} 입찰 {{$item.bids_count}}"
          },
          { "id": "ch", "type": "basic", "name": "H2", "text": "입찰 업체" },
          {
            "id": "crow",
            "type": "basic",
            "name": "P",
            "props": { "className": "py-2 border-b border-gray-200 dark:border-white/10" },
            "iteration": { "source": "{{companies.data}}", "item_var": "$co" },
            "text": "#{{$co.id}} {{$co.name}} user {{$co.user_id}} {{$co.status}}"
          }
        ]
      }
    ]
  }
}
