{
  "version": "1.0.0",
  "layout_name": "jobs_create",
  "extends": "_user_base",
  "meta": { "title": "의뢰서 작성" },
  "errorHandling": {
    "401": { "handler": "toast", "params": { "type": "warning", "message": "로그인이 필요합니다." } },
    "403": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "422": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "default": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
  },
  "state": {
    "form": {
      "title": "",
      "type": "print_3d",
      "budget": "",
      "description": "",
      "closes_at": ""
    }
  },
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "max-w-5xl mx-auto px-4 py-8 space-y-6" },
        "children": [
          {
            "id": "head",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-center justify-between gap-4 flex-wrap" },
            "children": [
              { "id": "h", "type": "basic", "name": "H1", "props": { "className": "text-2xl font-semibold text-gray-900 dark:text-white" }, "text": "의뢰서 작성" },
              {
                "id": "tabs",
                "type": "basic",
                "name": "Div",
                "props": { "className": "flex items-center gap-1 ml-auto flex-wrap" },
                "children": [
                  { "id": "t1", "type": "basic", "name": "A", "props": { "href": "/maker-bid/new", "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900" }, "text": "의뢰서 작성" },
                  { "id": "t2", "type": "basic", "name": "A", "props": { "href": "/maker-bid", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰목록" },
                  { "id": "t3", "type": "basic", "name": "A", "props": { "href": "/maker-bid/bids", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "입찰현황" },
                  { "id": "t4", "type": "basic", "name": "A", "props": { "href": "/maker-bid/history", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "이력" },
                  { "id": "t5", "type": "basic", "name": "A", "props": { "href": "/maker-bid/company", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-500 dark:text-gray-400" }, "text": "업체 등록" }
                ]
              }
            ]
          },
          { "id": "guide", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-500 dark:text-gray-400" }, "text": "3D 출력, 디자인, 상품 제작을 의뢰합니다. 제목과 유형은 필수입니다." },
          {
            "id": "form",
            "type": "basic",
            "name": "Div",
            "props": { "className": "max-w-xl space-y-3", "dataKey": "form", "trackChanges": true },
            "children": [
              { "id": "title_label", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-700 dark:text-gray-300" }, "text": "제목" },
              { "id": "title", "type": "basic", "name": "Input", "props": { "name": "title", "placeholder": "의뢰 제목 (예: PLA 피규어 15cm 출력)" } },
              { "id": "type_label", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-700 dark:text-gray-300" }, "text": "유형 (print_3d / design / manufacture)" },
              { "id": "type", "type": "basic", "name": "Input", "props": { "name": "type", "placeholder": "print_3d" } },
              { "id": "budget_label", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-700 dark:text-gray-300" }, "text": "예산(원, 선택)" },
              { "id": "budget", "type": "basic", "name": "Input", "props": { "name": "budget", "placeholder": "35000" } },
              { "id": "closes_label", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-700 dark:text-gray-300" }, "text": "마감 시각 (선택, 예: 2026-10-01 23:59:59)" },
              { "id": "closes", "type": "basic", "name": "Input", "props": { "name": "closes_at", "placeholder": "2026-10-01 23:59:59" } },
              { "id": "desc_label", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-700 dark:text-gray-300" }, "text": "설명" },
              { "id": "desc", "type": "basic", "name": "Textarea", "props": { "name": "description", "placeholder": "수량, 재질, 납기, 첨부 파일 설명" } },
              {
                "id": "submit",
                "type": "basic",
                "name": "Button",
                "text": "의뢰서 등록",
                "props": { "className": "px-4 py-2 rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900" },
                "actions": [
                  {
                    "type": "click",
                    "handler": "apiCall",
                    "auth_required": true,
                    "target": "/api/modules/custom-maker_bid/jobs",
                    "params": { "method": "POST", "body": "{{_local.form}}" },
                    "onSuccess": [
                      { "handler": "toast", "params": { "type": "success", "message": "의뢰가 등록되었습니다." } },
                      { "handler": "navigate", "params": { "path": "/maker-bid/{{response.data.id}}" } }
                    ],
                    "onError": [
                      { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
