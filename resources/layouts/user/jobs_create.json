{
  "version": "1.0.0",
  "layout_name": "jobs_create",
  "extends": "_user_base",
  "meta": { "title": "의뢰서 작성" },
  "state": { "form": { "title": "", "type": "print_3d", "budget": "", "description": "" } },
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "max-w-5xl mx-auto px-4 py-8 space-y-6" },
        "children": [
          {
            "id": "head",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-center justify-between gap-4 flex-wrap" },
            "children": [
              { "id": "h", "type": "basic", "name": "H1", "props": { "className": "text-2xl font-semibold text-gray-900 dark:text-white" }, "text": "의뢰/입찰" },
              {
                "id": "tabs",
                "type": "basic",
                "name": "Div",
                "props": { "className": "flex items-center gap-1 ml-auto flex-wrap" },
                "children": [
                  { "id": "t1", "type": "basic", "name": "A", "props": { "href": "/maker-bid/new", "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900" }, "text": "의뢰서 작성" },
                  { "id": "t2", "type": "basic", "name": "A", "props": { "href": "/maker-bid", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰목록" },
                  { "id": "t3", "type": "basic", "name": "A", "props": { "href": "/maker-bid/bids", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "입찰현황" },
                  { "id": "t4", "type": "basic", "name": "A", "props": { "href": "/maker-bid/history", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "이력" }
                ]
              }
            ]
          },
          {
            "id": "form",
            "type": "basic",
            "name": "Div",
            "props": { "className": "max-w-xl space-y-3", "dataKey": "form", "trackChanges": true },
            "children": [
              { "id": "title", "type": "basic", "name": "Input", "props": { "name": "title", "placeholder": "제목" } },
              { "id": "type", "type": "basic", "name": "Input", "props": { "name": "type", "placeholder": "print_3d / design / manufacture" } },
              { "id": "budget", "type": "basic", "name": "Input", "props": { "name": "budget", "placeholder": "예산(원)" } },
              { "id": "desc", "type": "basic", "name": "Textarea", "props": { "name": "description", "placeholder": "상세 설명" } },
              {
                "id": "submit",
                "type": "basic",
                "name": "Button",
                "text": "의뢰 등록",
                "props": { "className": "px-4 py-2 rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900" },
                "actions": [
                  {
                    "type": "click",
                    "handler": "apiCall",
                    "auth_required": true,
                    "target": "/api/modules/custom-maker_bid/jobs",
                    "params": { "method": "POST", "body": "{{_local.form}}" }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
