{
  "version": "1.0.0",
  "layout_name": "company_apply",
  "extends": "_user_base",
  "meta": { "title": "업체 등록" },
  "errorHandling": {
    "401": { "handler": "toast", "params": { "type": "warning", "message": "로그인이 필요합니다." } },
    "403": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "422": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "default": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
  },
  "state": {
    "company": {
      "name": "",
      "type": "print_3d",
      "note": ""
    }
  },
  "data_sources": [
    {
      "id": "me",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/companies/me",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "auth_required": true,
      "errorHandling": {
        "401": { "handler": "suppress" }
      },
      "fallback": { "data": null }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "max-w-5xl mx-auto px-4 py-8 space-y-6" },
        "children": [
          {
            "id": "head",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-center justify-between gap-4 flex-wrap" },
            "children": [
              { "id": "h", "type": "basic", "name": "H1", "props": { "className": "text-2xl font-semibold text-gray-900 dark:text-white" }, "text": "업체 등록" },
              {
                "id": "tabs",
                "type": "basic",
                "name": "Div",
                "props": { "className": "flex items-center gap-1 ml-auto flex-wrap" },
                "children": [
                  { "id": "t1", "type": "basic", "name": "A", "props": { "href": "/maker-bid/new", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰서 작성" },
                  { "id": "t2", "type": "basic", "name": "A", "props": { "href": "/maker-bid", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰목록" },
                  { "id": "t3", "type": "basic", "name": "A", "props": { "href": "/maker-bid/bids", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "입찰현황" },
                  { "id": "t4", "type": "basic", "name": "A", "props": { "href": "/maker-bid/history", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "이력" },
                  { "id": "t5", "type": "basic", "name": "A", "props": { "href": "/maker-bid/company", "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900" }, "text": "업체 등록" }
                ]
              }
            ]
          },
          { "id": "guide", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-500 dark:text-gray-400" }, "text": "회원도 입찰할 수 있습니다. 업체로 승인되면 입찰에 업체 정보가 붙습니다. 거절된 경우에만 다시 신청할 수 있습니다." },
          {
            "id": "pending",
            "type": "basic",
            "name": "P",
            "if": "{{me.data?.status === 'pending'}}",
            "props": { "className": "text-sm text-gray-800 dark:text-gray-200 py-4" },
            "text": "{{me.data.name}} — 승인 대기 중입니다."
          },
          {
            "id": "approved",
            "type": "basic",
            "name": "P",
            "if": "{{me.data?.status === 'approved'}}",
            "props": { "className": "text-sm text-gray-800 dark:text-gray-200 py-4" },
            "text": "{{me.data.name}} — 승인된 업체입니다. 열린 의뢰에 입찰할 수 있습니다."
          },
          {
            "id": "rejected",
            "type": "basic",
            "name": "P",
            "if": "{{me.data?.status === 'rejected'}}",
            "props": { "className": "text-sm text-gray-800 dark:text-gray-200 py-4" },
            "text": "거절되었습니다. 사유: {{me.data.rejected_reason ?? '없음'}}. 아래 양식으로 다시 신청할 수 있습니다."
          },
          {
            "id": "form",
            "type": "basic",
            "name": "Div",
            "if": "{{!me.data || me.data.status === 'rejected'}}",
            "props": { "className": "max-w-xl space-y-3", "dataKey": "company", "trackChanges": true },
            "children": [
              { "id": "name_label", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-700 dark:text-gray-300" }, "text": "업체 이름" },
              { "id": "name", "type": "basic", "name": "Input", "props": { "name": "name", "placeholder": "업체 이름" } },
              { "id": "type_label", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-700 dark:text-gray-300" }, "text": "주력 유형 (print_3d / design / manufacture, 선택)" },
              { "id": "type", "type": "basic", "name": "Input", "props": { "name": "type", "placeholder": "print_3d" } },
              { "id": "note_label", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-700 dark:text-gray-300" }, "text": "소개" },
              { "id": "note", "type": "basic", "name": "Textarea", "props": { "name": "note", "placeholder": "장비, 경력, 연락 메모" } },
              {
                "id": "submit",
                "type": "basic",
                "name": "Button",
                "text": "업체 신청",
                "props": { "className": "px-4 py-2 rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900" },
                "actions": [
                  {
                    "type": "click",
                    "handler": "apiCall",
                    "auth_required": true,
                    "target": "/api/modules/custom-maker_bid/companies",
                    "params": { "method": "POST", "body": "{{_local.company}}" },
                    "onSuccess": [
                      { "handler": "toast", "params": { "type": "success", "message": "업체 신청을 보냈습니다." } },
                      { "handler": "refetchDataSource", "params": { "dataSourceId": "me" } }
                    ],
                    "onError": [
                      { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
