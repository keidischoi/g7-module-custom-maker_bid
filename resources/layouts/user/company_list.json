{
  "version": "1.0.0",
  "layout_name": "company_list",
  "extends": "_user_base",
  "meta": {
    "title": "입찰자 목록"
  },
  "errorHandling": {
    "401": { "handler": "toast", "params": { "type": "warning", "message": "로그인이 필요합니다." } },
    "403": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "422": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "default": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
  },
  "data_sources": [
    {
      "id": "companies",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bids/companies",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "auth_mode": "optional",
      "fallback": { "data": [] },
      "params": { "page": "{{query.page || 1}}", "per_page": "{{query.per_page || 12}}" }
    },
    {
      "id": "me",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bids/companies/me",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "auth_required": true,
      "errorHandling": { "401": { "handler": "suppress" } },
      "fallback": { "data": null }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "cmb-page" },
        "children": [
          {
            "id": "head",
            "type": "basic",
            "name": "Div",
            "props": { "className": "cmb-page-head" },
            "children": [
              { "id": "h", "type": "basic", "name": "H1", "props": { "className": "cmb-page-title text-2xl font-semibold text-gray-900 dark:text-white" }, "text": "입찰자 목록" },
              {
                "id": "tabs",
                "type": "basic",
                "name": "Div",
                "props": { "className": "cmb-maker-subnav flex items-center justify-end gap-1 flex-wrap ml-auto", "data-cmb-subnav": "1" },
                "children": [
                  { "id": "t1", "type": "basic", "name": "A", "props": { "href": "/maker-bids/new", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰서 작성" },
                  { "id": "t2", "type": "basic", "name": "A", "props": { "href": "/maker-bids", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰목록" },
                  { "id": "t3", "type": "basic", "name": "A", "props": { "href": "/maker-bids/bids", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "입찰현황" },
                  { "id": "t4", "type": "basic", "name": "A", "props": { "href": "/maker-bids/history", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "이력" },
                  { "id": "t_disputes", "type": "basic", "name": "A", "props": { "href": "/maker-bids/disputes", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "분쟁" },
                  { "id": "t_payments", "type": "basic", "name": "A", "props": { "href": "/maker-bids/payments", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "결제" },
                  { "id": "t5", "type": "basic", "name": "A", "props": { "href": "/maker-bids/company", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "입찰자 등록" },
                  { "id": "t6", "type": "basic", "name": "A", "props": { "href": "/maker-bids/companies", "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900" }, "text": "입찰자 목록" }
                ]
              }
            ]
          },
          { "id": "cmb_notice", "type": "basic", "name": "Div", "props": { "className": "cmb-notice hidden", "data-cmb-notice": "companies" } },
          { "id": "guide", "type": "basic", "name": "P", "props": { "className": "cmb-page-guide" }, "text": "승인된 입찰자(업체·개인) 디렉터리입니다. 내 등록 상태는 아래 카드에서 확인할 수 있습니다." },
          {
            "id": "me_empty",
            "type": "basic",
            "name": "Div",
            "if": "{{!me.data}}",
            "props": { "className": "cmb-section-card" },
            "children": [
              { "id": "me_empty_t", "type": "basic", "name": "P", "props": { "className": "cmb-job-card-title" }, "text": "내 입찰자 등록" },
              { "id": "me_empty_d", "type": "basic", "name": "P", "props": { "className": "cmb-page-guide mt-2" }, "text": "아직 등록된 입찰자 정보가 없습니다." },
              { "id": "me_empty_a", "type": "basic", "name": "A", "props": { "href": "/maker-bids/company", "className": "cmb-btn cmb-btn-primary mt-3" }, "text": "입찰자 등록" }
            ]
          },
          {
            "id": "me_card",
            "type": "basic",
            "name": "Div",
            "if": "{{me.data}}",
            "props": { "className": "cmb-section-card" },
            "children": [
              {
                "id": "me_top",
                "type": "basic",
                "name": "Div",
                "props": { "className": "cmb-job-card-top" },
                "children": [
                  {
                    "id": "cmb_me_logo",
                    "type": "basic",
                    "name": "Img",
                    "if": "{{me.data.thumbnail_url || me.data.logo_url}}",
                    "props": {
                      "src": "{{me.data.thumbnail_url || me.data.logo_url}}",
                      "alt": "",
                      "className": "cmb-list-thumb cmb-list-thumb-round",
                      "width": "72",
                      "height": "72"
                    }
                  },
                  { "id": "me_name", "type": "basic", "name": "P", "props": { "className": "cmb-job-card-title" }, "text": "내 등록 · {{me.data.name}}" },
                  { "id": "me_badge", "type": "basic", "name": "Span", "props": { "className": "cmb-badge cmb-badge-{{me.data.status}}" }, "text": "{{me.data.status_label || me.data.status}}" }
                ]
              },
              {
                "id": "me_meta",
                "type": "basic",
                "name": "Div",
                "props": { "className": "cmb-job-card-meta" },
                "children": [
                  { "id": "me_kind", "type": "basic", "name": "Span", "text": "{{me.data.kind_label || me.data.kind}}" },
                  { "id": "me_hold", "type": "basic", "name": "Span", "if": "{{me.data.hold_reason}}", "text": "보류: {{me.data.hold_reason}}" }
                ]
              },
              { "id": "me_act", "type": "basic", "name": "A", "props": { "href": "/maker-bids/company", "className": "cmb-btn cmb-btn-secondary mt-3" }, "text": "등록 정보 관리" }
            ]
          },
          {
            "id": "dir_card",
            "type": "basic",
            "name": "Div",
            "props": { "className": "cmb-section-card" },
            "children": [
              {
                "id": "dh_row",
                "type": "basic",
                "name": "Div",
                "props": { "className": "cmb-section-head" },
                "children": [
                  { "id": "dh", "type": "basic", "name": "H2", "props": { "className": "cmb-section-title" }, "text": "공개 입찰자" }
                ]
              },
              { "id": "empty", "type": "basic", "name": "P", "if": "{{!(companies?.data?.data ?? companies?.data ?? []).length}}", "props": { "className": "cmb-empty" }, "text": "공개된 입찰자가 없습니다." },
              {
                "id": "clist",
                "type": "basic",
                "name": "Div",
                "props": { "className": "cmb-card-list cmb-company-gallery" },
                "children": [
                  {
                    "id": "citem",
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "cmb-company-card cmb-list-item" },
                    "iteration": { "source": "{{companies?.data?.data ?? companies?.data ?? []}}", "item_var": "$item" },
                    "children": [
                      {
                        "id": "ctop",
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "cmb-company-card-top" },
                        "children": [
                          {
                            "id": "cmb_co_logo",
                            "type": "basic",
                            "name": "Img",
                            "if": "{{$item.thumbnail_url || $item.logo_url}}",
                            "props": {
                              "src": "{{$item.thumbnail_url || $item.logo_url}}",
                              "alt": "",
                              "className": "cmb-list-thumb cmb-list-thumb-round",
                              "width": "72",
                              "height": "72"
                            }
                          },
                          { "id": "cname", "type": "basic", "name": "P", "props": { "className": "cmb-company-card-title" }, "text": "{{$item.name}}" },
                          {
                            "id": "cbadges",
                            "type": "basic",
                            "name": "Div",
                            "props": { "className": "flex gap-1 flex-wrap" },
                            "children": [
                              { "id": "ckind", "type": "basic", "name": "Span", "props": { "className": "cmb-badge" }, "text": "{{$item.kind_label || $item.kind}}" },
                              { "id": "crec", "type": "basic", "name": "Span", "if": "{{$item.is_recommended}}", "props": { "className": "cmb-badge cmb-badge-rec" }, "text": "추천" }
                            ]
                          }
                        ]
                      },
                      { "id": "cbio", "type": "basic", "name": "P", "if": "{{$item.bio}}", "props": { "className": "cmb-page-guide mt-2" }, "text": "{{$item.bio}}" },
                      {
                        "id": "cmeta",
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "cmb-company-card-meta" },
                        "children": [
                          { "id": "cr", "type": "basic", "name": "Span", "if": "{{$item.rating_count}}", "text": "평점 {{$item.rating_score}} ({{$item.rating_count}})" },
                          { "id": "ch", "type": "basic", "name": "A", "if": "{{$item.homepage_url}}", "props": { "href": "{{$item.homepage_url}}", "className": "underline", "target": "_blank", "rel": "noopener" }, "text": "홈페이지" },
                          { "id": "cp", "type": "basic", "name": "A", "if": "{{$item.portfolio_url}}", "props": { "href": "{{$item.portfolio_url}}", "className": "underline", "target": "_blank", "rel": "noopener" }, "text": "포트폴리오" }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "companies_pager",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-pager",
                  "data-cmb-pager": "1",
                  "data-param": "page",
                  "data-page": "{{companies?.data?.meta?.page || 1}}",
                  "data-total": "{{companies?.data?.meta?.total || 0}}",
                  "data-last-page": "{{companies?.data?.meta?.last_page || 1}}",
                  "data-per-page": "{{companies?.data?.meta?.per_page || 12}}"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
