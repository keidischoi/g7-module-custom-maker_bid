{
  "version": "1.0.0",
  "layout_name": "company_list",
  "extends": "_user_base",
  "meta": { "title": "입찰자 목록" },
  "data_sources": [
    {
      "id": "me",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bids/companies/me",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "auth_required": true,
      "errorHandling": { "401": { "handler": "suppress" } },
      "fallback": { "data": null }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "max-w-5xl mx-auto px-4 py-8 space-y-6" },
        "children": [
          {
            "id": "head",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-center justify-between gap-4 flex-wrap" },
            "children": [
              { "id": "h", "type": "basic", "name": "H1", "props": { "className": "text-2xl font-semibold text-gray-900 dark:text-white" }, "text": "입찰자 목록" },
              {
                "id": "tabs",
                "type": "basic",
                "name": "Div",
                "props": { "className": "cmb-maker-subnav flex items-center gap-1 ml-auto flex-wrap justify-end", "data-cmb-subnav": "1" },
                "children": [
                  { "id": "t1", "type": "basic", "name": "A", "props": { "href": "/maker-bids/new", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰서 작성" },
                  { "id": "t2", "type": "basic", "name": "A", "props": { "href": "/maker-bids", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰목록" },
                  { "id": "t3", "type": "basic", "name": "A", "props": { "href": "/maker-bids/bids", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "입찰현황" },
                  { "id": "t4", "type": "basic", "name": "A", "props": { "href": "/maker-bids/history", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "이력" },
                  { "id": "t5", "type": "basic", "name": "A", "props": { "href": "/maker-bids/company", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "입찰자 등록" },
                  { "id": "t6", "type": "basic", "name": "A", "props": { "href": "/maker-bids/companies", "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900" }, "text": "입찰자 목록" }
                ]
              }
            ]
          },
          { "id": "guide", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-500 dark:text-gray-400" }, "text": "내 입찰자 등록 상태입니다. 새 신청은 입찰자 등록 탭에서 합니다." },
          { "id": "empty", "type": "basic", "name": "P", "if": "{{!me.data}}", "props": { "className": "text-sm text-gray-500 dark:text-gray-400 py-8" }, "text": "등록된 입찰자 정보가 없습니다. 입찰자 등록 탭에서 신청하세요." },
          {
            "id": "pending",
            "type": "basic",
            "name": "Div",
            "if": "{{me.data?.status === 'pending'}}",
            "props": { "className": "rounded-xl border border-gray-200 dark:border-gray-700 px-4 py-4 space-y-1 text-sm text-gray-800 dark:text-gray-200" },
            "children": [
              { "id": "pending_h", "type": "basic", "name": "P", "props": { "className": "font-medium" }, "text": "{{me.data.name}} — 보류(승인 대기) 중입니다." },
              { "id": "pending_kind", "type": "basic", "name": "P", "text": "등록유형 {{me.data.kind_label || me.data.kind}}" },
              { "id": "pending_hold", "type": "basic", "name": "P", "if": "{{me.data.hold_reason}}", "text": "보류 이유: {{me.data.hold_reason}}" }
            ]
          },
          {
            "id": "approved",
            "type": "basic",
            "name": "Div",
            "if": "{{me.data?.status === 'approved'}}",
            "props": { "className": "rounded-xl border border-gray-200 dark:border-gray-700 px-4 py-4 space-y-1 text-sm text-gray-800 dark:text-gray-200" },
            "children": [
              { "id": "approved_h", "type": "basic", "name": "P", "props": { "className": "font-medium" }, "text": "{{me.data.name}} — 승인된 입찰자입니다." },
              { "id": "approved_kind", "type": "basic", "name": "P", "text": "{{me.data.kind_label || me.data.kind}}" }
            ]
          },
          {
            "id": "rejected",
            "type": "basic",
            "name": "P",
            "if": "{{me.data?.status === 'rejected'}}",
            "props": { "className": "text-sm text-gray-800 dark:text-gray-200 py-2" },
            "text": "거절되었습니다. 입찰자 등록 탭에서 다시 신청할 수 있습니다."
          }
        ]
      }
    ]
  }
}
