{
  "version": "1.0.0",
  "layout_name": "jobs_history",
  "extends": "_user_base",
  "meta": {
    "title": "이력"
  },
  "errorHandling": {
    "401": {
      "handler": "toast",
      "params": {
        "type": "warning",
        "message": "로그인이 필요합니다."
      }
    },
    "403": {
      "handler": "toast",
      "params": {
        "type": "error",
        "message": "{{error.message}}"
      }
    },
    "422": {
      "handler": "toast",
      "params": {
        "type": "error",
        "message": "{{error.message}}"
      }
    },
    "default": {
      "handler": "toast",
      "params": {
        "type": "error",
        "message": "{{error.message}}"
      }
    }
  },
  "data_sources": [
    {
      "id": "jobs",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bids/jobs/mine",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "auth_required": true,
      "errorHandling": {
        "401": {
          "handler": "suppress"
        }
      },
      "fallback": {
        "data": []
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "cmb-page"
        },
        "children": [
          {
            "id": "head",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-page-head"
            },
            "children": [
              {
                "id": "h",
                "type": "basic",
                "name": "H1",
                "props": {
                  "className": "cmb-page-title text-2xl font-semibold text-gray-900 dark:text-white"
                },
                "text": "이력"
              },
              {
                "id": "tabs",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-maker-subnav flex items-center gap-1 flex-wrap ml-auto",
                  "data-cmb-subnav": "1"
                },
                "children": [
                  {
                    "id": "t1",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids/new",
                      "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                    },
                    "text": "의뢰서 작성"
                  },
                  {
                    "id": "t2",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids",
                      "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                    },
                    "text": "의뢰목록"
                  },
                  {
                    "id": "t3",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids/bids",
                      "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                    },
                    "text": "입찰현황"
                  },
                  {
                    "id": "t4",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids/history",
                      "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900"
                    },
                    "text": "이력"
                  },
                  {
                    "id": "t5",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids/company",
                      "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                    },
                    "text": "입찰자 등록"
                  },
                  {
                    "id": "t6",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids/companies",
                      "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                    },
                    "text": "입찰자 목록"
                  }
                ]
              }
            ]
          },
          {
            "id": "cmb_notice",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-notice hidden",
              "data-cmb-notice": "history"
            }
          },
          {
            "id": "guide",
            "type": "basic",
            "name": "P",
            "props": {
              "className": "cmb-page-guide"
            },
            "text": "내가 등록한 의뢰의 진행·내정·완료·보류·취소 이력입니다."
          },
          {
            "id": "empty",
            "type": "basic",
            "name": "P",
            "if": "{{!(jobs?.data?.data ?? jobs?.data ?? []).length}}",
            "props": {
              "className": "cmb-empty"
            },
            "text": "내 의뢰 이력이 없습니다. 로그인 후 의뢰서를 등록하면 여기에 표시됩니다."
          },
          {
            "id": "list",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-card-list"
            },
            "children": [
              {
                "id": "item_wrap",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-job-card"
                },
                "iteration": {
                  "source": "{{jobs?.data?.data ?? jobs?.data ?? []}}",
                  "item_var": "$item"
                },
                "children": [
                  {
                    "id": "top",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "cmb-job-card-top"
                    },
                    "children": [
                      {
                        "id": "title",
                        "type": "basic",
                        "name": "A",
                        "props": {
                          "href": "/maker-bids/{{$item.id}}",
                          "className": "cmb-job-card-title"
                        },
                        "text": "{{$item.title}}"
                      },
                      {
                        "id": "badge",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "cmb-badge cmb-badge-{{$item.status}}"
                        },
                        "text": "{{$item.status_label || $item.status}}"
                      }
                    ]
                  },
                  {
                    "id": "meta",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "cmb-job-card-meta"
                    },
                    "children": [
                      {
                        "id": "m1",
                        "type": "basic",
                        "name": "Span",
                        "text": "{{$item.budget_label || '예산 미정'}}"
                      },
                      {
                        "id": "m2",
                        "type": "basic",
                        "name": "Span",
                        "text": "{{$item.updated_at}}"
                      },
                      {
                        "id": "m3",
                        "type": "basic",
                        "name": "Span",
                        "if": "{{$item.work_status}}",
                        "text": "작업 {{$item.work_status}}"
                      }
                    ]
                  },
                  {
                    "id": "actions",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "cmb-job-card-actions"
                    },
                    "children": [
                      {
                        "id": "a1",
                        "type": "basic",
                        "name": "A",
                        "props": {
                          "href": "/maker-bids/{{$item.id}}",
                          "className": "cmb-btn cmb-btn-secondary"
                        },
                        "text": "상세"
                      },
                      {
                        "id": "a2",
                        "type": "basic",
                        "name": "A",
                        "if": "{{$item.status === 'awarded' || $item.status === 'done'}}",
                        "props": {
                          "href": "/maker-bids/{{$item.id}}/work",
                          "className": "cmb-btn cmb-btn-primary"
                        },
                        "text": "작업실"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
