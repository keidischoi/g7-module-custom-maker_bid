                      "className": "cmb-btn cmb-btn-primary"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bids/jobs/{{route.id}}/messages",
                        "params": {
                          "method": "POST",
                          "body": "{{_local.msg}}"
                        },
                        "onSuccess": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "success",
                              "message": "메시지를 보냈습니다."
                            }
                          },
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "msg.body": ""
                            }
                          },
                          {
                            "handler": "refetchDataSource",
                            "params": {
                              "dataSourceId": "msgs"
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "error",
                              "message": "{{error.message}}"
                            }
                          }
                        ]
                      }
                    ]
                  }
