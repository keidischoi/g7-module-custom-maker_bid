{
  "version": "1.0.0",
  "layout_name": "jobs_workspace",
  "extends": "_user_base",
  "meta": {
    "title": "낙찰 작업실"
  },
  "errorHandling": {
    "401": {
      "handler": "toast",
      "params": {
        "type": "warning",
        "message": "로그인이 필요합니다."
      }
    },
    "403": {
      "handler": "toast",
      "params": {
        "type": "error",
        "message": "{{error.message}}"
      }
    },
    "422": {
      "handler": "toast",
      "params": {
        "type": "error",
        "message": "{{error.message}}"
      }
    },
    "default": {
      "handler": "toast",
      "params": {
        "type": "error",
        "message": "{{error.message}}"
      }
    }
  },
  "state": {
    "msg": {
      "body": ""
    },
    "complete": {
      "score": "5",
      "comment": ""
    },
    "claim": {
      "reason": ""
    },
    "report": {
      "reason": ""
    },
    "ship": {
      "carrier": "",
      "tracking_no": ""
    }
  },
  "data_sources": [
    {
      "id": "job",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bids/jobs/{{route.id}}",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "auth_required": true
    },
    {
      "id": "msgs",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bids/jobs/{{route.id}}/messages",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "errorHandling": {
        "401": {
          "handler": "suppress"
        },
        "403": {
          "handler": "suppress"
        },
        "503": {
          "handler": "suppress"
        }
      },
      "fallback": {
        "data": []
      }
    },
    {
      "id": "cmp",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bids/jobs/{{route.id}}/compare",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "errorHandling": {
        "401": {
          "handler": "suppress"
        },
        "403": {
          "handler": "suppress"
        }
      },
      "fallback": {
        "data": []
      }
    },
    {
      "id": "form_defaults",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bids/jobs/form-defaults",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "errorHandling": {
        "401": {
          "handler": "suppress"
        }
      },
      "fallback": {
        "data": {
          "upload_token": ""
        }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "cmb-page"
        },
        "children": [
          {
            "id": "tabs",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-maker-subnav flex items-center justify-end gap-1 flex-nowrap ml-auto",
              "data-cmb-subnav": "1"
            },
            "children": [
              {
                "id": "t1",
                "type": "basic",
                "name": "A",
                "props": {
                  "href": "/maker-bids/new",
                  "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                },
                "text": "의뢰서 작성"
              },
              {
                "id": "t2",
                "type": "basic",
                "name": "A",
                "props": {
                  "href": "/maker-bids",
                  "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                },
                "text": "의뢰목록"
              },
              {
                "id": "t3",
                "type": "basic",
                "name": "A",
                "props": {
                  "href": "/maker-bids/bids",
                  "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                },
                "text": "입찰현황"
              },
              {
                "id": "t4",
                "type": "basic",
                "name": "A",
                "props": {
                  "href": "/maker-bids/history",
                  "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900"
                },
                "text": "이력"
              },
              {
                "id": "t5",
                "type": "basic",
                "name": "A",
                "props": {
                  "href": "/maker-bids/company",
                  "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                },
                "text": "입찰자 등록"
              },
              {
                "id": "t6",
                "type": "basic",
                "name": "A",
                "props": {
                  "href": "/maker-bids/companies",
                  "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                },
                "text": "입찰자 목록"
              }
            ]
          },
          {
            "id": "hero",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-section-card cmb-show-hero"
            },
            "children": [
              {
                "id": "h",
                "type": "basic",
                "name": "H1",
                "props": {
                  "className": "cmb-page-title text-2xl font-semibold text-gray-900 dark:text-white"
                },
                "text": "작업실 · {{job.data.title}}"
              },
              {
                "id": "meta",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-show-meta-row"
                },
                "children": [
                  {
                    "id": "b1",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "cmb-badge cmb-badge-{{job.data.status}}"
                    },
                    "text": "{{job.data.status_label || job.data.status}}"
                  },
                  {
                    "id": "b2",
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": "cmb-badge"
                    },
                    "text": "진행 {{job.data.work_status || '-'}}"
                  }
                ]
              },
              {
                "id": "ship",
                "type": "basic",
                "name": "P",
                "props": {
                  "className": "cmb-page-guide"
                },
                "text": "송장 {{job.data.carrier || '-'}} {{job.data.tracking_no || ''}}"
              },
              {
                "id": "navrow",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-job-card-actions"
                },
                "children": [
                  {
                    "id": "back",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids/{{route.id}}",
                      "className": "cmb-btn cmb-btn-secondary"
                    },
                    "text": "의뢰 상세"
                  }
                ]
              }
            ]
          },
          {
            "id": "actions_card",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-section-card"
            },
            "children": [
              {
                "id": "ah",
                "type": "basic",
                "name": "H2",
                "props": {
                  "className": "cmb-section-title"
                },
                "text": "작업 상태"
              },
              {
                "id": "workspace_actions",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-workspace-actions mt-3"
                },
                "children": [
                  {
                    "id": "work_producing",
                    "type": "basic",
                    "name": "Button",
                    "text": "제작중",
                    "props": {
                      "className": "cmb-btn cmb-btn-secondary"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bids/jobs/{{route.id}}/work",
                        "params": {
                          "method": "POST",
                          "body": {
                            "work_status": "producing"
                          }
                        },
                        "onSuccess": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "success",
                              "message": "제작중으로 표시했습니다."
                            }
                          },
                          {
                            "handler": "refetchDataSource",
                            "params": {
                              "dataSourceId": "job"
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "error",
                              "message": "{{error.message}}"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "work_printing",
                    "type": "basic",
                    "name": "Button",
                    "text": "출력중",
                    "props": {
                      "className": "cmb-btn cmb-btn-secondary"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bids/jobs/{{route.id}}/work",
                        "params": {
                          "method": "POST",
                          "body": {
                            "work_status": "printing"
                          }
                        },
                        "onSuccess": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "success",
                              "message": "출력중으로 표시했습니다."
                            }
                          },
                          {
                            "handler": "refetchDataSource",
                            "params": {
                              "dataSourceId": "job"
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "error",
                              "message": "{{error.message}}"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "work_delivered",
                    "type": "basic",
                    "name": "Button",
                    "text": "배송완료",
                    "props": {
                      "className": "cmb-btn cmb-btn-secondary"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bids/jobs/{{route.id}}/work",
                        "params": {
                          "method": "POST",
                          "body": {
                            "work_status": "delivered"
                          }
                        },
                        "onSuccess": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "success",
                              "message": "배송완료로 표시했습니다."
                            }
                          },
                          {
                            "handler": "refetchDataSource",
                            "params": {
                              "dataSourceId": "job"
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "error",
                              "message": "{{error.message}}"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "ship_box",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-order-card mt-3 space-y-2",
                  "dataKey": "ship",
                  "trackChanges": true
                },
                "children": [
                  {
                    "id": "ship_h",
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "cmb-section-title"
                    },
                    "text": "발송 · 송장"
                  },
                  {
                    "id": "carrier_l",
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "cmb-admin-label text-xs text-gray-500"
                    },
                    "text": "택배사"
                  },
                  {
                    "id": "carrier",
                    "type": "basic",
                    "name": "Input",
                    "props": {
                      "name": "carrier",
                      "placeholder": "예: CJ대한통운",
                      "className": "cmb-order-field w-full rounded-lg border px-3 py-2 text-sm"
                    }
                  },
                  {
                    "id": "track_l",
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "cmb-admin-label text-xs text-gray-500"
                    },
                    "text": "송장번호"
                  },
                  {
                    "id": "tracking_no",
                    "type": "basic",
                    "name": "Input",
                    "props": {
                      "name": "tracking_no",
                      "placeholder": "송장번호",
                      "className": "cmb-order-field w-full rounded-lg border px-3 py-2 text-sm"
                    }
                  },
                  {
                    "id": "ship_btn",
                    "type": "basic",
                    "name": "Button",
                    "text": "발송 처리",
                    "props": {
                      "className": "cmb-btn cmb-btn-primary"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bids/jobs/{{route.id}}/work",
                        "params": {
                          "method": "POST",
                          "body": {
                            "work_status": "shipping",
                            "carrier": "{{_local.ship.carrier}}",
                            "tracking_no": "{{_local.ship.tracking_no}}"
                          }
                        },
                        "onSuccess": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "success",
                              "message": "발송으로 표시했습니다."
                            }
                          },
                          {
                            "handler": "refetchDataSource",
                            "params": {
                              "dataSourceId": "job"
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "error",
                              "message": "{{error.message}}"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "delivery_box",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-order-card mt-3 space-y-2"
                },
                "children": [
                  {
                    "id": "del_h",
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "cmb-section-title"
                    },
                    "text": "납품 파일 (낙찰자)"
                  },
                  {
                    "id": "del_g",
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "cmb-page-guide"
                    },
                    "text": "제작 결과물·납품 파일입니다. 업로드 후 30일 만료되며, 만료 시 다운로드가 막히고 스케줄이 스토리지를 비웁니다(다운로드 로그는 유지)."
                  },
                  {
                    "id": "cmb_delivery_uploader",
                    "type": "composite",
                    "name": "FileUploader",
                    "props": {
                      "collection": "delivery",
                      "maxFiles": 10,
                      "maxSize": 50,
                      "accept": ".zip,.stl,.3mf,.obj,.pdf,.png,.jpg,.jpeg,.webp,.tar,.gz,.7z,.step,.stp",
                      "autoUpload": true,
                      "className": "cmb-order-uploader mt-1",
                      "apiEndpoints": {
                        "upload": "/api/modules/custom-maker_bids/jobs/{{route.id}}/files",
                        "delete": "/api/modules/custom-maker_bids/uploads/:id",
                        "reorder": ""
                      },
                      "uploadParams": {
                        "collection": "delivery",
                        "token": "{{form_defaults.data.upload_token}}",
                        "upload_token": "{{form_defaults.data.upload_token}}"
                      }
                    },
                    "actions": [
                      {
                        "event": "onUploadError",
                        "handler": "toast",
                        "params": {
                          "type": "error",
                          "message": "{{$args[0]}}"
                        }
                      },
                      {
                        "event": "onUploadSuccess",
                        "handler": "toast",
                        "params": {
                          "type": "success",
                          "message": "납품 파일을 올렸습니다."
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "complete_box",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-order-card mt-4 space-y-3",
                  "dataKey": "complete",
                  "trackChanges": true
                },
                "children": [
                  {
                    "id": "ch",
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "cmb-section-title"
                    },
                    "text": "완료 · 후기"
                  },
                  {
                    "id": "cguide",
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "cmb-page-guide"
                    },
                    "text": "의뢰자만 완료할 수 있습니다. 점수(1–5)와 후기를 입력하세요."
                  },
                  {
                    "id": "score_l",
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "cmb-admin-label text-xs text-gray-500"
                    },
                    "text": "점수"
                  },
                  {
                    "id": "score",
                    "type": "basic",
                    "name": "Select",
                    "props": {
                      "name": "score",
                      "value": "{{_local.complete.score}}",
                      "className": "cmb-order-field rounded-lg border px-3 py-2 text-sm",
                      "options": [
                        {
                          "value": "5",
                          "label": "5점"
                        },
                        {
                          "value": "4",
                          "label": "4점"
                        },
                        {
                          "value": "3",
                          "label": "3점"
                        },
                        {
                          "value": "2",
                          "label": "2점"
                        },
                        {
                          "value": "1",
                          "label": "1점"
                        }
                      ]
                    },
                    "actions": [
                      {
                        "type": "change",
                        "event": "change",
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "complete.score": "{{$event.target.value}}"
                        }
                      }
                    ]
                  },
                  {
                    "id": "comment_l",
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "cmb-admin-label text-xs text-gray-500"
                    },
                    "text": "후기"
                  },
                  {
                    "id": "comment",
                    "type": "basic",
                    "name": "Textarea",
                    "props": {
                      "name": "comment",
                      "placeholder": "거래 후기 (선택)",
                      "className": "cmb-order-field w-full min-h-[72px] rounded-lg border px-3 py-2 text-sm"
                    }
                  },
                  {
                    "id": "done",
                    "type": "basic",
                    "name": "Button",
                    "text": "완료 처리",
                    "props": {
                      "className": "cmb-btn cmb-btn-primary"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/modules/custom-maker_bids/jobs/{{route.id}}/complete",
                        "params": {
                          "method": "POST",
                          "body": "{{_local.complete}}"
                        },
                        "confirm": "완료 처리하고 후기를 남길까요?",
                        "onSuccess": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "success",
                              "message": "완료했습니다."
                            }
                          },
                          {
                            "handler": "refetchDataSource",
                            "params": {
                              "dataSourceId": "job"
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "toast",
                            "params": {
                              "type": "error",
                              "message": "{{error.message}}"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "msg_card",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-section-card"
            },
            "children": [
              {
                "id": "mh",
                "type": "basic",
                "name": "H2",
                "props": {
                  "className": "cmb-section-title"
                },
                "text": "1:1 대화 · 쪽지"
              },
              {
                "id": "mguide",
                "type": "basic",
                "name": "P",
                "props": {
                  "className": "cmb-page-guide mt-1"
                },
                "text": "낙찰 당사자(의뢰자·제작자)만 이 스레드에서 대화합니다. 외부 쪽지 모듈이 있으면 알림도 연동되며, 없어도 앱 내 대화로 충분합니다."
              },
              {
                "id": "mempty",
                "type": "basic",
                "name": "P",
                "if": "{{!(msgs?.data?.data ?? msgs?.data ?? []).length}}",
                "props": {
                  "className": "cmb-page-guide mt-2"
                },
                "text": "아직 쪽지가 없습니다. 아래에서 첫 메시지를 보내 보세요."
              },
              {
                "id": "mlist",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-msg-thread mt-3"
                },
                "children": [
                  {
                    "id": "mrow",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "cmb-msg-bubble cmb-list-item",
                      "data-cmb-mine": "{{$item.is_mine ? 1 : 0}}"
                    },
                    "iteration": {
                      "source": "{{msgs?.data?.data ?? msgs?.data ?? []}}",
                      "item_var": "$item"
                    },
                    "children": [
                      {
                        "id": "mt",
                        "type": "basic",
                        "name": "P",
                        "props": {
                          "className": "cmb-msg-meta"
                        },
                        "text": "{{$item.author_label}} · {{$item.created_at}}"
                      },
                      {
                        "id": "mb",
                        "type": "basic",
                        "name": "P",
                        "props": {
                          "className": "cmb-msg-body whitespace-pre-wrap"
                        },
                        "text": "{{$item.body}}"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "mcompose",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-order-card mt-4 space-y-2",
                  "dataKey": "msg",
                  "trackChanges": true
                },
                "children": [
                  {
                    "id": "mcl",
                    "type": "basic",
                    "name": "P",
                    "props": {
