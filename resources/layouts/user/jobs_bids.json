{
  "version": "1.0.0",
  "layout_name": "jobs_bids",
  "extends": "_user_base",
  "meta": {
    "title": "입찰현황"
  },
  "errorHandling": {
    "401": {
      "handler": "toast",
      "params": {
        "type": "warning",
        "message": "로그인이 필요합니다."
      }
    },
    "403": {
      "handler": "toast",
      "params": {
        "type": "error",
        "message": "{{error.message}}"
      }
    },
    "422": {
      "handler": "toast",
      "params": {
        "type": "error",
        "message": "{{error.message}}"
      }
    },
    "default": {
      "handler": "toast",
      "params": {
        "type": "error",
        "message": "{{error.message}}"
      }
    }
  },
  "data_sources": [
    {
      "id": "jobs",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bids/jobs",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "auth_mode": "optional",
      "params": {
        "status": "open",
        "page": "{{query.page || 1}}",
        "per_page": "{{query.per_page || 10}}"
      },
      "fallback": {
        "data": []
      }
    },
    {
      "id": "mine",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bids/bids/mine",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "auth_required": true,
      "errorHandling": {
        "401": {
          "handler": "suppress"
        }
      },
      "fallback": {
        "data": []
      },
      "params": {
        "page": "{{query.mine_page || 1}}",
        "per_page": "{{query.per_page || 10}}"
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "cmb-page"
        },
        "children": [
          {
            "id": "head",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-page-head"
            },
            "children": [
              {
                "id": "h",
                "type": "basic",
                "name": "H1",
                "props": {
                  "className": "cmb-page-title text-2xl font-semibold text-gray-900 dark:text-white"
                },
                "text": "입찰현황"
              },
              {
                "id": "tabs",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-maker-subnav flex items-center justify-end gap-1 flex-nowrap ml-auto",
                  "data-cmb-subnav": "1"
                },
                "children": [
                  {
                    "id": "t1",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids/new",
                      "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                    },
                    "text": "의뢰서 작성"
                  },
                  {
                    "id": "t2",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids",
                      "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                    },
                    "text": "의뢰목록"
                  },
                  {
                    "id": "t3",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids/bids",
                      "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900"
                    },
                    "text": "입찰현황"
                  },
                  {
                    "id": "t4",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids/history",
                      "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                    },
                    "text": "이력"
                  },
                  {
                    "id": "t5",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids/company",
                      "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                    },
                    "text": "입찰자 등록"
                  },
                  {
                    "id": "t6",
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/maker-bids/companies",
                      "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300"
                    },
                    "text": "입찰자 목록"
                  }
                ]
              }
            ]
          },
          {
            "id": "cmb_notice",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-notice hidden",
              "data-cmb-notice": "bids"
            }
          },
          {
            "id": "guide",
            "type": "basic",
            "name": "P",
            "props": {
              "className": "cmb-page-guide"
            },
            "text": "열린 의뢰에 견적을 넣고, 열려 있는 동안 내 금액을 수정할 수 있습니다. 입찰자면 입찰자 등록에서 승인 상태를 확인하세요."
          },
          {
            "id": "mine_card",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-section-card"
            },
            "children": [
              {
                "id": "mh_row",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-section-head"
                },
                "children": [
                  {
                    "id": "mh",
                    "type": "basic",
                    "name": "H2",
                    "props": {
                      "className": "cmb-section-title"
                    },
                    "text": "내 입찰"
                  }
                ]
              },
              {
                "id": "mine_empty",
                "type": "basic",
                "name": "P",
                "if": "{{!(mine?.data?.data ?? mine?.data ?? []).length}}",
                "props": {
                  "className": "cmb-empty"
                },
                "text": "내 입찰이 없습니다. 로그인 후 열린 의뢰에 견적을 넣으면 여기에 표시됩니다."
              },
              {
                "id": "mine_list",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-card-list"
                },
                "children": [
                  {
                    "id": "mine_item",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "cmb-job-card cmb-list-item"
                    },
                    "iteration": {
                      "source": "{{mine?.data?.data ?? mine?.data ?? []}}",
                      "item_var": "$item"
                    },
                    "children": [
                      {
                        "id": "mtop",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "cmb-job-card-top"
                        },
                        "children": [
                          {
                            "id": "mtitle",
                            "type": "basic",
                            "name": "A",
                            "props": {
                              "href": "/maker-bids/{{$item.job_id}}",
                              "className": "cmb-job-card-title"
                            },
                            "text": "{{$item.job.title ?? ('의뢰 #' + $item.job_id)}}"
                          },
                          {
                            "id": "mbadge",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "cmb-badge cmb-badge-{{$item.status}}"
                            },
                            "text": "{{$item.status_label || $item.status}}"
                          }
                        ]
                      },
                      {
                        "id": "mmeta",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "cmb-job-card-meta"
                        },
                        "children": [
                          {
                            "id": "mm1",
                            "type": "basic",
                            "name": "Span",
                            "text": "{{$item.amount_label || ($item.amount + '원')}}"
                          },
                          {
                            "id": "mm2",
                            "type": "basic",
                            "name": "Span",
                            "text": "{{$item.days != null ? ($item.days + '일') : '일수 미정'}}"
                          }
                        ]
                      },
                      {
                        "id": "mactions",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "cmb-job-card-actions"
                        },
                        "children": [
                          {
                            "id": "ma1",
                            "type": "basic",
                            "name": "A",
                            "props": {
                              "href": "/maker-bids/{{$item.job_id}}",
                              "className": "cmb-btn cmb-btn-secondary"
                            },
                            "text": "수정·확인"
                          },
                          {
                            "id": "ma2",
                            "type": "basic",
                            "name": "A",
                            "if": "{{$item.status === 'awarded'}}",
                            "props": {
                              "href": "/maker-bids/{{$item.job_id}}/work",
                              "className": "cmb-btn cmb-btn-primary"
                            },
                            "text": "작업실"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "mine_pager",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-pager",
                  "data-cmb-pager": "1",
                  "data-param": "mine_page",
                  "data-page": "{{mine?.data?.meta?.page || 1}}",
                  "data-total": "{{mine?.data?.meta?.total || 0}}",
                  "data-last-page": "{{mine?.data?.meta?.last_page || 1}}",
                  "data-per-page": "{{mine?.data?.meta?.per_page || 10}}"
                }
              }
            ]
          },
          {
            "id": "open_card",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "cmb-section-card"
            },
            "children": [
              {
                "id": "oh_row",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-section-head"
                },
                "children": [
                  {
                    "id": "oh",
                    "type": "basic",
                    "name": "H2",
                    "props": {
                      "className": "cmb-section-title"
                    },
                    "text": "입찰 가능한 의뢰"
                  }
                ]
              },
              {
                "id": "open_empty",
                "type": "basic",
                "name": "P",
                "if": "{{!(jobs?.data?.data ?? jobs?.data ?? []).length}}",
                "props": {
                  "className": "cmb-empty"
                },
                "text": "현재 입찰 중인 의뢰가 없습니다."
              },
              {
                "id": "open_list",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "cmb-card-list"
                },
                "children": [
                  {
                    "id": "item",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "cmb-job-card cmb-list-item cmb-open-bid-card",
                      "data-cmb-open-bid-card": "1",
                      "data-job-id": "{{$item.id}}",
                      "data-job-title": "{{$item.title}}"
                    },
                    "iteration": {
                      "source": "{{jobs?.data?.data ?? jobs?.data ?? []}}",
                      "item_var": "$item"
                    },
                    "children": [
                      {
                        "id": "otop",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "cmb-job-card-top"
                        },
                        "children": [
                          {
                            "id": "otitle",
                            "type": "basic",
                            "name": "A",
                            "props": {
                              "href": "/maker-bids/{{$item.id}}",
                              "className": "cmb-job-card-title"
                            },
                            "text": "{{$item.title}}"
                          },
                          {
                            "id": "obadge",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "cmb-badge cmb-badge-{{$item.status}}"
                            },
                            "text": "{{$item.status_label || $item.status}}"
                          }
                        ]
                      },
                      {
                        "id": "ometa",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "cmb-job-card-meta"
                        },
                        "children": [
                          {
                            "id": "om1",
                            "type": "basic",
                            "name": "Span",
                            "text": "견적 {{$item.bids_count ?? 0}}건"
                          },
                          {
                            "id": "om2",
                            "type": "basic",
                            "name": "Span",
                            "text": "예산 {{$item.budget_label || $item.budget || '미정'}}"
                          }
                        ]
                      },
                      {
                        "id": "oact",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "cmb-job-card-actions"
                        },
                        "children": [
                          {
                            "id": "obid_btn",
                            "type": "basic",
                            "name": "Button",
                            "text": "견적 넣기",
                            "props": {
                              "type": "button",
                              "className": "cmb-btn cmb-btn-primary cmb-open-bid-toggle",
                              "data-cmb-open-bid-toggle": "1",
                              "data-job-id": "{{$item.id}}"
                            }
                          },
                          {
                            "id": "odetail",
                            "type": "basic",
                            "name": "A",
                            "props": {
                              "href": "/maker-bids/{{$item.id}}",
                              "className": "cmb-btn cmb-btn-secondary"
                            },
                            "text": "상세"
                          }
                        ]
                      },
                      {
                        "id": "obid_panel",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "cmb-section-card cmb-form-stack cmb-bid-form cmb-open-bid-panel mt-3 space-y-3",
                          "data-cmb-open-bid-panel": "1",
                          "data-job-id": "{{$item.id}}",
                          "hidden": true,
                          "style": "display:none"
                        },
                        "children": [
                          {
                            "id": "obid_h",
                            "type": "basic",
                            "name": "P",
                            "props": {
                              "className": "cmb-section-title text-sm font-semibold"
                            },
                            "text": "견적 입력"
                          },
                          {
                            "id": "obid_amount",
                            "type": "basic",
                            "name": "Input",
                            "props": {
                              "name": "amount",
                              "type": "number",
                              "min": "1",
                              "placeholder": "견적 금액(원)",
                              "className": "cmb-order-field cmb-open-bid-amount",
                              "data-cmb-bid-amount": "1"
                            }
                          },
                          {
                            "id": "obid_days",
                            "type": "basic",
                            "name": "Input",
                            "props": {
                              "name": "days",
                              "type": "number",
                              "min": "1",
                              "placeholder": "제작 일수",
                              "className": "cmb-order-field cmb-open-bid-days",
                              "data-cmb-bid-days": "1"
                            }
                          },
                          {
                            "id": "obid_msg",
                            "type": "basic",
                            "name": "Textarea",
                            "props": {
                              "name": "message",
                              "placeholder": "메시지(선택)",
                              "className": "cmb-order-field cmb-open-bid-message min-h-[72px]",
                              "data-cmb-bid-message": "1"
                            }
                          },
                          {
                            "id": "obid_actions",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                              "className": "flex flex-wrap gap-2"
                            },
                            "children": [
                              {
                                "id": "obid_submit",
                                "type": "basic",
                                "name": "Button",
                                "text": "견적 제출",
                                "props": {
                                  "type": "button",
                                  "className": "cmb-btn cmb-btn-primary cmb-open-bid-submit",
                                  "data-cmb-open-bid-submit": "1",
                                  "data-job-id": "{{$item.id}}"
                                }
                              },
                              {
                                "id": "obid_cancel",
                                "type": "basic",
                                "name": "Button",
                                "text": "취소",
                                "props": {
                                  "type": "button",
                                  "className": "cmb-btn cmb-btn-secondary cmb-open-bid-cancel",
                                  "data-cmb-open-bid-cancel": "1"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "open_pager",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "cmb-pager",
                      "data-cmb-pager": "1",
                      "data-param": "page",
                      "data-page": "{{jobs?.data?.meta?.page || 1}}",
                      "data-total": "{{jobs?.data?.meta?.total || 0}}",
                      "data-last-page": "{{jobs?.data?.meta?.last_page || 1}}",
                      "data-per-page": "{{jobs?.data?.meta?.per_page || 10}}"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
