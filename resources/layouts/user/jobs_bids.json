{
  "version": "1.0.0",
  "layout_name": "jobs_bids",
  "extends": "_user_base",
  "meta": { "title": "입찰현황" },
  "errorHandling": {
    "401": { "handler": "toast", "params": { "type": "warning", "message": "로그인이 필요합니다." } },
    "403": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "422": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "default": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
  },
  "data_sources": [
    {
      "id": "jobs",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/jobs",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "params": { "status": "open" },
      "fallback": { "data": [] }
    },
    {
      "id": "mine",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/bids/mine",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "auth_required": true,
      "errorHandling": {
        "401": { "handler": "suppress" }
      },
      "fallback": { "data": [] }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "max-w-5xl mx-auto px-4 py-8 space-y-6" },
        "children": [
          {
            "id": "head",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-center justify-between gap-4 flex-wrap" },
            "children": [
              { "id": "h", "type": "basic", "name": "H1", "props": { "className": "text-2xl font-semibold text-gray-900 dark:text-white" }, "text": "입찰현황" },
              {
                "id": "tabs",
                "type": "basic",
                "name": "Div",
                "props": { "className": "flex items-center gap-1 ml-auto flex-wrap" },
                "children": [
                  { "id": "t1", "type": "basic", "name": "A", "props": { "href": "/maker-bid/new", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰서 작성" },
                  { "id": "t2", "type": "basic", "name": "A", "props": { "href": "/maker-bid", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰목록" },
                  { "id": "t3", "type": "basic", "name": "A", "props": { "href": "/maker-bid/bids", "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900" }, "text": "입찰현황" },
                  { "id": "t4", "type": "basic", "name": "A", "props": { "href": "/maker-bid/history", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "이력" },
                  { "id": "t5", "type": "basic", "name": "A", "props": { "href": "/maker-bid/company", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-500 dark:text-gray-400" }, "text": "업체 등록" }
                ]
              }
            ]
          },
          { "id": "guide", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-500 dark:text-gray-400" }, "text": "열린 의뢰에 견적을 넣고, 열려 있는 동안 내 금액을 수정할 수 있습니다. 업체 회원이면 업체 등록에서 승인 상태를 확인하세요." },
          { "id": "mh", "type": "basic", "name": "H2", "props": { "className": "text-lg font-medium text-gray-900 dark:text-white" }, "text": "내 입찰" },
          {
            "id": "mine_empty",
            "type": "basic",
            "name": "P",
            "if": "{{!(mine.data && mine.data.length)}}",
            "props": { "className": "text-sm text-gray-500 dark:text-gray-400 py-4" },
            "text": "내 입찰이 없습니다. 로그인 후 열린 의뢰에 견적을 넣으면 여기에 표시됩니다."
          },
          {
            "id": "mine_item",
            "type": "basic",
            "name": "A",
            "props": { "href": "/maker-bid/{{$item.job_id}}", "className": "block py-3 border-b border-gray-200 dark:border-white/10 text-gray-900 dark:text-white" },
            "iteration": { "source": "{{mine.data}}", "item_var": "$item" },
            "text": "{{$item.job.title ?? $item.job_id}}  |  {{$item.amount}}원  |  {{$item.status}}  |  수정·확인"
          },
          { "id": "oh", "type": "basic", "name": "H2", "props": { "className": "text-lg font-medium text-gray-900 dark:text-white pt-4" }, "text": "입찰 가능한 의뢰" },
          {
            "id": "open_empty",
            "type": "basic",
            "name": "P",
            "if": "{{!(jobs.data && jobs.data.length)}}",
            "props": { "className": "text-sm text-gray-500 dark:text-gray-400 py-4" },
            "text": "현재 입찰 중인 의뢰가 없습니다."
          },
          {
            "id": "item",
            "type": "basic",
            "name": "A",
            "props": { "href": "/maker-bid/{{$item.id}}", "className": "block py-4 border-b border-gray-200 dark:border-white/10 text-gray-900 dark:text-white" },
            "iteration": { "source": "{{jobs.data}}", "item_var": "$item" },
            "text": "{{$item.title}}  |  견적 {{$item.bids_count ?? 0}}건  |  예산 {{$item.budget ?? '미정'}}  |  견적 넣기"
          }
        ]
      }
    ]
  }
}
