{
  "version": "1.0.0",
  "layout_name": "jobs_bids",
  "extends": "_user_base",
  "meta": { "title": "입찰" },
  "data_sources": [
    {
      "id": "jobs",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/jobs?status=open",
      "method": "GET",
      "auto_fetch": true
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "max-w-5xl mx-auto px-4 py-8 space-y-6" },
        "children": [
          {
            "id": "head",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-center justify-between gap-4" },
            "children": [
              { "id": "h", "type": "basic", "name": "H1", "props": { "className": "text-2xl font-semibold text-gray-900 dark:text-white" }, "text": "의뢰/입찰" },
              {
                "id": "tabs",
                "type": "basic",
                "name": "Div",
                "props": { "className": "flex items-center gap-1 ml-auto" },
                "children": [
                  {
                    "id": "tab_req",
                    "type": "basic",
                    "name": "A",
                    "props": { "href": "/maker-bid", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800" },
                    "text": "의뢰"
                  },
                  {
                    "id": "tab_bid",
                    "type": "basic",
                    "name": "A",
                    "props": { "href": "/maker-bid/bids", "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900" },
                    "text": "입찰"
                  }
                ]
              }
            ]
          },
          { "id": "hint", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-500 dark:text-gray-400" }, "text": "열린 의뢰에 견적을 냄 수 있습니다." },
          {
            "id": "item",
            "type": "basic",
            "name": "A",
            "props": { "href": "/maker-bid/{{$item.id}}", "className": "block py-4 border-b border-gray-200 dark:border-white/10 text-gray-900 dark:text-white" },
            "iteration": { "source": "{{jobs.data}}", "item_var": "$item" },
            "text": "{{$item.title}} · {{$item.type}} · 예산 {{$item.budget}}원 · 입찰 {{$item.bids_count}}"
          }
        ]
      }
    ]
  }
}
