{
  "version": "1.0.0",
  "layout_name": "jobs_list",
  "extends": "_user_base",
  "meta": { "title": "의뢰목록" },
  "errorHandling": {
    "401": { "handler": "toast", "params": { "type": "warning", "message": "로그인이 필요합니다." } },
    "403": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "422": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "default": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
  },
  "data_sources": [
    {
      "id": "types",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/job-types",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "fallback": { "data": [] }
    },
    {
      "id": "jobs",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/jobs",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "auth_mode": "optional",
      "params": { "type": "{{query.type}}" },
      "fallback": { "data": [] }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "max-w-5xl mx-auto px-4 py-8 space-y-6" },
        "children": [
          {
            "id": "head",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-center justify-between gap-4 flex-wrap" },
            "children": [
              { "id": "h", "type": "basic", "name": "H1", "props": { "className": "text-2xl font-semibold text-gray-900 dark:text-white" }, "text": "의뢰목록" },
              {
                "id": "tabs",
                "type": "basic",
                "name": "Div",
                "props": { "className": "flex items-center gap-1 ml-auto flex-wrap" },
                "children": [
                  { "id": "t1", "type": "basic", "name": "A", "props": { "href": "/maker-bid/new", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰서 작성" },
                  { "id": "t2", "type": "basic", "name": "A", "props": { "href": "/maker-bid", "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900" }, "text": "의뢰목록" },
                  { "id": "t3", "type": "basic", "name": "A", "props": { "href": "/maker-bid/bids", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "입찰현황" },
                  { "id": "t4", "type": "basic", "name": "A", "props": { "href": "/maker-bid/history", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "이력" },
                  { "id": "t5", "type": "basic", "name": "A", "props": { "href": "/maker-bid/company", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-500 dark:text-gray-400" }, "text": "입찰자 등록" }
                ]
              }
            ]
          },
          { "id": "guide", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-500 dark:text-gray-400" }, "text": "등록된 의뢰서입니다. 보류 상태 의뢰는 공개 목록에 나오지 않습니다." },
          {
            "id": "filters",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-center gap-2 flex-wrap text-sm" },
            "children": [
              { "id": "f0", "type": "basic", "name": "A", "props": { "href": "/maker-bid", "className": "px-2 py-1 rounded-lg border border-gray-200 dark:border-white/10 text-gray-700 dark:text-gray-300" }, "text": "전체" },
              {
                "id": "ftype",
                "type": "basic",
                "name": "A",
                "props": { "href": "/maker-bid?type={{$type.slug}}", "className": "px-2 py-1 rounded-lg border border-gray-200 dark:border-white/10 text-gray-700 dark:text-gray-300" },
                "iteration": { "source": "{{types.data}}", "item_var": "$type" },
                "text": "{{$type.name}}"
              }
            ]
          },
          {
            "id": "empty",
            "type": "basic",
            "name": "P",
            "if": "{{!(jobs.data && jobs.data.length)}}",
            "props": { "className": "text-sm text-gray-500 dark:text-gray-400 py-10" },
            "text": "등록된 의뢰가 없습니다. 의뢰서 작성에서 첫 의뢰를 올려 보세요."
          },
          {
            "id": "item",
            "type": "basic",
            "name": "A",
            "props": { "href": "/maker-bid/{{$item.id}}", "className": "block py-4 border-b border-gray-200 dark:border-white/10 text-gray-900 dark:text-white" },
            "iteration": { "source": "{{jobs.data}}", "item_var": "$item" },
            "text": "{{$item.title}}  |  {{$item.type_name || $item.type}}  |  {{$item.status_label || $item.status}}  |  공개 {{$item.audience_label || '전체'}}  |  예산 {{$item.budget_label || '미정'}}  |  견적 {{$item.bids_count ?? 0}}"
          }
        ]
      }
    ]
  }
}
