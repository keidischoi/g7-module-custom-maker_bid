{
  "version": "1.0.0",
  "layout_name": "jobs_list",
  "meta": { "title": "의뢰/입찰" },
  "data_sources": [
    {
      "id": "jobs",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/jobs",
      "method": "GET",
      "auto_fetch": true
    }
  ],
  "components": [
    {
      "id": "page",
      "type": "basic",
      "name": "Div",
      "props": { "className": "max-w-4xl mx-auto px-4 py-12 space-y-6" },
      "children": [
        { "id": "h", "type": "basic", "name": "H1", "text": "의뢰/입찰" },
        { "id": "d", "type": "basic", "name": "P", "text": "회원이 의뢰서를 올리고, 회원이나 등록 업체가 견적을 냄니다." },
        {
          "id": "write",
          "type": "basic",
          "name": "A",
          "props": { "href": "/maker-bid/new" },
          "text": "의뢰서 작성"
        },
        {
          "id": "item",
          "type": "basic",
          "name": "P",
          "props": { "className": "py-4 border-b border-gray-200 dark:border-white/10" },
          "iteration": { "source": "{{jobs.data}}", "item_var": "$item" },
          "text": "{{$item.title}} · {{$item.type}} · {{$item.status}} · {{$item.budget}}원"
        }
      ]
    }
  ]
}
