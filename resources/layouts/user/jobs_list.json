{
  "version": "1.0.0",
  "layout_name": "jobs_list",
  "meta": { "title": "제작 의뢰" },
  "data_sources": [
    {
      "id": "jobs",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/jobs",
      "method": "GET",
      "auto_fetch": true
    }
  ],
  "components": [
    {
      "id": "page",
      "type": "basic",
      "name": "Div",
      "props": { "className": "max-w-4xl mx-auto px-4 py-12 space-y-6" },
      "children": [
        { "id": "h", "type": "basic", "name": "H1", "props": { "className": "text-3xl font-semibold" }, "text": "제작 의뢰" },
        { "id": "d", "type": "basic", "name": "P", "text": "3D 출력, 디자인, 상품 제작을 의뢰하고 제작자가 입찰합니다." },
        {
          "id": "item",
          "type": "basic",
          "name": "A",
          "props": { "href": "/maker-bid/{{$item.id}}", "className": "block py-4 border-b" },
          "iteration": { "source": "{{jobs.data}}", "item_var": "$item" },
          "text": "{{$item.title}} · {{$item.type}} · {{$item.status}}"
        }
      ]
    }
  ]
}
