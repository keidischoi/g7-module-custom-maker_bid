{
  "version": "1.0.0",
  "layout_name": "jobs_show",
  "extends": "_user_base",
  "meta": { "title": "의뢰 상세" },
  "errorHandling": {
    "401": { "handler": "toast", "params": { "type": "warning", "message": "로그인이 필요합니다." } },
    "403": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "422": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } },
    "default": { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
  },
  "state": { "bid": { "amount": "", "days": "", "message": "" } },
  "data_sources": [
    {
      "id": "job",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/jobs/{{route.id}}",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true
    },
    {
      "id": "viewer",
      "type": "api",
      "endpoint": "/api/modules/custom-maker_bid/jobs/{{route.id}}/viewer",
      "method": "GET",
      "auto_fetch": true,
      "refetchOnMount": true,
      "auth_required": true,
      "errorHandling": {
        "401": { "handler": "suppress" }
      },
      "fallback": {
        "data": {
          "authenticated": false,
          "is_owner": false,
          "is_open": false,
          "can_bid": false,
          "can_award": false,
          "can_update_bid": false,
          "my_bid": null
        }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "page",
        "type": "basic",
        "name": "Div",
        "props": { "className": "max-w-3xl mx-auto px-4 py-10 space-y-6" },
        "children": [
          {
            "id": "tabs",
            "type": "basic",
            "name": "Div",
            "props": { "className": "flex items-center gap-1 flex-wrap" },
            "children": [
              { "id": "t1", "type": "basic", "name": "A", "props": { "href": "/maker-bid/new", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰서 작성" },
              { "id": "t2", "type": "basic", "name": "A", "props": { "href": "/maker-bid", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "의뢰목록" },
              { "id": "t3", "type": "basic", "name": "A", "props": { "href": "/maker-bid/bids", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "입찰현황" },
              { "id": "t4", "type": "basic", "name": "A", "props": { "href": "/maker-bid/history", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-600 dark:text-gray-300" }, "text": "이력" },
              { "id": "t5", "type": "basic", "name": "A", "props": { "href": "/maker-bid/company", "className": "px-3 py-1.5 text-sm rounded-lg text-gray-500 dark:text-gray-400" }, "text": "업체 등록" }
            ]
          },
          { "id": "h", "type": "basic", "name": "H1", "props": { "className": "text-2xl font-semibold text-gray-900 dark:text-white" }, "text": "{{job.data.title}}" },
          { "id": "meta", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-500 dark:text-gray-400" }, "text": "유형 {{job.data.type}} · 예산 {{job.data.budget ?? '미정'}} · 상태 {{job.data.status}} · 마감 {{job.data.closes_at ?? '없음'}}" },
          { "id": "desc", "type": "basic", "name": "P", "props": { "className": "whitespace-pre-wrap text-gray-800 dark:text-gray-200" }, "text": "{{job.data.description ?? ''}}" },
          {
            "id": "owner_note",
            "type": "basic",
            "name": "P",
            "if": "{{viewer.data?.is_owner}}",
            "props": { "className": "text-sm text-gray-700 dark:text-gray-300" },
            "text": "내 의뢰입니다. 열린 상태에서는 견적을 낙찰할 수 있습니다."
          },
          { "id": "bids_h", "type": "basic", "name": "H2", "props": { "className": "text-lg text-gray-900 dark:text-white" }, "text": "들어온 견적" },
          {
            "id": "bids_empty",
            "type": "basic",
            "name": "P",
            "if": "{{!(job.data.bids && job.data.bids.length)}}",
            "props": { "className": "text-sm text-gray-500 dark:text-gray-400 py-4" },
            "text": "아직 들어온 견적이 없습니다."
          },
          {
            "id": "bidrow_{{idx}}",
            "type": "basic",
            "name": "Div",
            "props": { "className": "py-3 border-b border-gray-200 dark:border-white/10 space-y-2" },
            "iteration": { "source": "{{job.data.bids}}", "item_var": "$bid", "index_var": "idx" },
            "children": [
              { "id": "bidtxt_{{idx}}", "type": "basic", "name": "P", "props": { "className": "text-gray-800 dark:text-gray-200" }, "text": "#{{$bid.id}} {{$bid.amount}}원 / {{$bid.days ?? '-'}}일 · {{$bid.status}} · {{$bid.message ?? ''}}" },
              {
                "id": "award_{{idx}}",
                "type": "basic",
                "name": "Button",
                "if": "{{viewer.data?.can_award}}",
                "text": "이 견적으로 낙찰",
                "props": { "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900" },
                "actions": [
                  {
                    "type": "click",
                    "handler": "apiCall",
                    "auth_required": true,
                    "target": "/api/modules/custom-maker_bid/jobs/{{route.id}}/award",
                    "params": { "method": "POST", "body": { "bid_id": "{{$bid.id}}" } },
                    "confirm": "이 견적으로 낙찰할까요? 나머지 입찰은 거절됩니다.",
                    "onSuccess": [
                      { "handler": "toast", "params": { "type": "success", "message": "낙찰되었습니다." } },
                      { "handler": "refetchDataSource", "params": { "dataSourceId": "job" } },
                      { "handler": "refetchDataSource", "params": { "dataSourceId": "viewer" } }
                    ],
                    "onError": [
                      { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "login_hint",
            "type": "basic",
            "name": "P",
            "if": "{{!viewer.data?.authenticated && job.data?.status === 'open'}}",
            "props": { "className": "text-sm text-gray-500 dark:text-gray-400" },
            "text": "로그인하면 견적을 넣을 수 있습니다. 본인 의뢰에는 입찰할 수 없습니다."
          },
          {
            "id": "closed_hint",
            "type": "basic",
            "name": "P",
            "if": "{{job.data?.status && job.data.status !== 'open'}}",
            "props": { "className": "text-sm text-gray-500 dark:text-gray-400" },
            "text": "이 의뢰는 열려 있지 않아 견적·낙찰을 할 수 없습니다."
          },
          {
            "id": "bidform",
            "type": "basic",
            "name": "Div",
            "if": "{{viewer.data?.can_bid && !viewer.data?.my_bid}}",
            "props": { "className": "space-y-3", "dataKey": "bid", "trackChanges": true },
            "children": [
              { "id": "bh", "type": "basic", "name": "H2", "props": { "className": "text-lg text-gray-900 dark:text-white" }, "text": "견적 넣기" },
              { "id": "amount", "type": "basic", "name": "Input", "props": { "name": "amount", "placeholder": "견적 금액(원)" } },
              { "id": "days", "type": "basic", "name": "Input", "props": { "name": "days", "placeholder": "제작 일수" } },
              { "id": "msg", "type": "basic", "name": "Input", "props": { "name": "message", "placeholder": "메시지" } },
              {
                "id": "submit",
                "type": "basic",
                "name": "Button",
                "text": "견적 제출",
                "props": { "className": "px-4 py-2 rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900" },
                "actions": [
                  {
                    "type": "click",
                    "handler": "apiCall",
                    "auth_required": true,
                    "target": "/api/modules/custom-maker_bid/jobs/{{route.id}}/bids",
                    "params": { "method": "POST", "body": "{{_local.bid}}" },
                    "onSuccess": [
                      { "handler": "toast", "params": { "type": "success", "message": "견적을 등록했습니다." } },
                      { "handler": "refetchDataSource", "params": { "dataSourceId": "job" } },
                      { "handler": "refetchDataSource", "params": { "dataSourceId": "viewer" } }
                    ],
                    "onError": [
                      { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "editform",
            "type": "basic",
            "name": "Div",
            "if": "{{viewer.data?.can_update_bid}}",
            "props": { "className": "space-y-3", "dataKey": "bid", "trackChanges": true },
            "children": [
              { "id": "eh", "type": "basic", "name": "H2", "props": { "className": "text-lg text-gray-900 dark:text-white" }, "text": "내 견적 수정" },
              { "id": "cur", "type": "basic", "name": "P", "props": { "className": "text-sm text-gray-500 dark:text-gray-400" }, "text": "현재 {{viewer.data.my_bid.amount}}원 / {{viewer.data.my_bid.days ?? '-'}}일 · {{viewer.data.my_bid.status}}. 의뢰가 열려 있는 동안 금액을 바꿀 수 있습니다." },
              { "id": "eamount", "type": "basic", "name": "Input", "props": { "name": "amount", "placeholder": "새 견적 금액(원)" } },
              { "id": "edays", "type": "basic", "name": "Input", "props": { "name": "days", "placeholder": "제작 일수" } },
              { "id": "emsg", "type": "basic", "name": "Input", "props": { "name": "message", "placeholder": "메시지" } },
              {
                "id": "esubmit",
                "type": "basic",
                "name": "Button",
                "text": "금액 수정",
                "props": { "className": "px-4 py-2 rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900" },
                "actions": [
                  {
                    "type": "click",
                    "handler": "apiCall",
                    "auth_required": true,
                    "target": "/api/modules/custom-maker_bid/jobs/{{route.id}}/bids/{{viewer.data.my_bid.id}}",
                    "params": { "method": "PATCH", "body": "{{_local.bid}}" },
                    "onSuccess": [
                      { "handler": "toast", "params": { "type": "success", "message": "견적 금액을 수정했습니다." } },
                      { "handler": "refetchDataSource", "params": { "dataSourceId": "job" } },
                      { "handler": "refetchDataSource", "params": { "dataSourceId": "viewer" } }
                    ],
                    "onError": [
                      { "handler": "toast", "params": { "type": "error", "message": "{{error.message}}" } }
                    ]
                  }
                ]
              }
            ]
          },
          { "id": "co_link", "type": "basic", "name": "A", "props": { "href": "/maker-bid/company", "className": "inline-block text-sm text-gray-500 dark:text-gray-400 underline" }, "text": "업체로 등록하기" }
        ]
      }
    ]
  }
}
